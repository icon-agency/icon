{
  "name": "icon-agency",
  "version": "0.1.0",
  "private": true,
  "description": "ICON Agency site — semantic HTML + Tailwind v4 + GSAP, built for Drupal (SDC / Canvas) handoff.",
  "scripts": {
    "dev": "tailwindcss -i src/main.css -o css/main.css --watch",
    "build": "tailwindcss -i src/main.css -o css/main.css --minify",
    "verify": "node scripts/verify.mjs",
    "build:theme": "tailwindcss -i drupal/web/themes/custom/icon/src/main.css -o drupal/web/themes/custom/icon/css/main.css --minify && node scripts/theme-js.mjs",
    "dev:theme": "tailwindcss -i drupal/web/themes/custom/icon/src/main.css -o drupal/web/themes/custom/icon/css/main.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.9",
    "tailwindcss": "^4.1.9"
  },
  "dependencies": {
    "gsap": "^3.13.0"
  }
}
