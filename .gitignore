node_modules/
v40-1-icon/
.DS_Store
*.log

# unrelated nested project
GreenPowerDS/

# Drupal install (drupal/) — Composer-managed code stays out; custom code + config stay in
drupal/vendor/
drupal/web/core/
drupal/web/modules/contrib/
drupal/web/themes/contrib/
drupal/web/profiles/contrib/
drupal/web/libraries/
drupal/web/sites/*/files/
drupal/web/sites/*/private/
drupal/web/sites/*/settings.local.php
drupal/web/sites/*/services.local.yml
drupal/web/sites/simpletest/
drupal/.ddev/.*
drupal/.ddev/db_snapshots/
drupal/.ddev/*.yaml
!drupal/.ddev/config.yaml
# The Redis add-on's compose file, because settings.ddev.redis.php IS
# committed and settings.php includes it: ignore the compose file and a
# fresh clone wires Drupal to a cache backend whose container does not
# exist, and every request fatals (found in review, Sep 2026).
!drupal/.ddev/docker-compose.redis.yaml
drupal/.ddev/traefik/
drupal/.ddev/postgres/
drupal/.ddev/mysql/
drupal/.ddev/xhprof/
drupal/web/sites/*/settings.ddev.php

# local database + files backups (never push: the repo is public)
drupal/backups/

# PHP tooling scratch (PHPStan cache)
drupal/.tmp/
