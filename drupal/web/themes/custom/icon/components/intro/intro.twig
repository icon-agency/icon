{#
/**
 * @file
 * intro — thin copy of the intro strip in templates/homeC.html. The
 * filmstrip is its own component (icon:filmstrip, js/filmstrip.js),
 * embedded here; the word cascade is js/reveal.js's and the pinned
 * expertise band js/home-c.js's (Drupal.behaviors.iconHomeC). The photos, the four fact
 * cards and the expertise list are theme content for now — a later slice
 * makes them editable (see docs/drupal-handoff.md).
 */
#}
{# An SDC has no page context (base_path / directory): resolve the theme's own path. #}
{% set theme_path = file_url(active_theme_path()) %}
<section class="intro u-container" aria-label="About ICON">
  <video class="intro__mark" autoplay loop muted playsinline aria-hidden="true" data-intro-mark>
    <source src="{{ theme_path }}/assets/intro/logo-long.mp4" type='video/mp4; codecs="hvc1"' />
    <source src="{{ theme_path }}/assets/intro/logo-long.webm" type="video/webm" />
  </video>
  <h2 class="intro__headline" data-reveal-words>
    <span class="lockup-accent masthead-accent">{{ accent }}</span>
    <span class="lockup-caps">{{ caps }}</span>
  </h2>
  {# SLOT strip: Photo and Fact card components, in the order they should
     drift — handed to the filmstrip component, which is the strip. #}
  {% embed 'icon:filmstrip' with { label: 'The ICON team'|t } %}
    {% block cards %}{{ strip }}{% endblock %}
  {% endembed %}

<div class="intro__band">
    {# The Expertise links BLOCK (icon_expertise_links) in the band's left
       tracks: it renders the row (expertise-links.twig) from the main
       menu, its gutter off; the wrapper carries the grid placement and
       the reveal's delay, which the row's data-animate reads (Sep 2026 —
       the row was typed here, item by item, before). #}
    <div class="intro__expertise" style="--animate-delay: 120ms">
{# SLOT expertise: the Expertise links block. #}
{{ expertise }}
    </div>
    <div class="intro__prose">
      <p class="intro__statement" data-reveal-words>{{ statement }}</p>
      {% if about_url %}<a class="intro__about quiet-link invite-arrow" href="{{ about_url }}" data-animate style="--animate-delay: 200ms">{{ about_label|default('About us'|t) }}</a>{% endif %}
    </div>
  </div>
</section>
