{#
/**
 * @file
 * news-card — thin copy of the card in templates/news-b.html.
 * Classes are the src/components/news-card.css contract; behaviours
 * (cursor tilt, media reveal) are the host page's (js/news.js, js/reveal.js).
 */
#}
{% set tag = heading_level|default('h2') %}
<a class="news-card" href="{{ url }}" aria-label="{{ title }}">
  <figure class="news-card__figure media-reveal" data-reveal-img>
    <img class="news-card__img" loading="lazy" src="{{ image.src }}" alt="{{ image.alt }}"{% if image.width %} width="{{ image.width }}"{% endif %}{% if image.height %} height="{{ image.height }}"{% endif %} />
  </figure>
  <div class="news-card__body">
    <{{ tag }} class="news-card__title">{{ title }}</{{ tag }}>
    <span class="news-card__meta">{{ category }} / <time datetime="{{ date }}">{{ date|date('j M Y') }}</time></span>
  </div>
</a>
