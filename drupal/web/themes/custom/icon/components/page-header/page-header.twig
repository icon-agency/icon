{#
/**
 * @file
 * page-header — the centred masthead lockup (src/components/page-header.css,
 * `.page-header--stack`): the serif accent line over the caps line, both
 * centred, entering on the shared word cascade ([data-reveal-words],
 * js/reveal.js).
 *
 * ONE definition of this lockup. It was written out twice, in the /work and
 * /news Views templates, so the two could drift and Canvas could place
 * neither (found in review, Sep 2026). Those templates now embed this and
 * fill the two slots with what is theirs; a Canvas page places it with the
 * slots empty.
 */
#}
{% set tag = heading_level|default('h1') %}
{# The opening: which <html> class hands over as this masthead scrolls away.
   The class itself is put on <html> by icon_preprocess_html() (a Canvas
   page reads it off this component; the listings set their own), so the
   page opens in it with no flash; here the masthead only names it for
   js/theme-handover.js. #}
{# dark-hold is not here on purpose: it opens dark and never hands over
   (the contact page), so there is nothing to mark for the behaviour. #}
{% set handover_class = attribute({ dark: 'dark', blue: 'theme-blue', 'light-grey': 'theme-work-article', custom: 'theme-work-article' }, opening|default('none'))|default('') %}
<div class="page-header page-header--stack"{% if handover_class %} data-theme-handover data-theme-handover-class="{{ handover_class }}"{% endif %}>
  <div class="page-header__inner">
    <{{ tag }} class="page-header__heading page-header__heading--lockup" data-reveal-words>
      <span class="page-header__lockup-accent masthead-accent">{{ accent }}</span>
      <span class="page-header__lockup-caps">{{ caps|nl2br }}</span>
    </{{ tag }}>
    {% block extras %}{{ extras }}{% endblock %}
  </div>
  {# the band is FULL width — the masthead's gutter is given back here, and
     whatever is placed brings its own (the Filmstrip bleeds, Columns and a
     pull quote pad on the page gutter) #}
  <div class="page-header__band">{% block band %}{{ band }}{% endblock %}</div>
</div>
