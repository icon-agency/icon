{#
/**
 * @file
 * work-gallery-figure — one figure of a gallery row. A plain figure is one
 * picture or film; portrait crops it to 7:10; a layered figure floats its
 * cut-out over its ground (a picture, a film, or --overlay-ground), wide or
 * square.
 *
 * `picture` and `float` are the picks (Sep 2026: one field each, picture or
 * film) — a media id from Canvas, or the resolved media from the theme's
 * paragraph path (icon.theme). `media`, `film` and `film_layer` are what an
 * instance placed before carries, still honoured below.
 *
 * The classes are self-sufficient: the styles used to hang off a
 * `.work-gallery` ancestor, which is why a figure could not be placed on its
 * own (Sep 2026).
 */
#}
{% set layered = style starts with 'layered' %}
{% set ground_m = picture is defined and picture ? (picture is iterable ? picture : icon_media(picture, 'work_media')) : {} %}
{% set float_m = float is defined and float ? (float is iterable ? float : icon_media(float, 'work_media')) : {} %}
{% if ground_m.src is defined or float_m.src is defined %}
  {% set layers = layered ? [ground_m, float_m] : [ground_m.src is defined ? ground_m : float_m] %}
{% else %}
  {# an instance placed before: pictures and the film apart, the film taking
     the ground (or the float, by film_layer) #}
  {% set pictures = (media|default([]))|map(m => m|merge({ type: 'image' })) %}
  {% set clip = film.src is defined and film.src ? { type: 'video', src: film.src, poster: film.poster|default('') } : null %}
  {% if not layered %}
    {% set layers = clip ? [clip] : pictures|slice(0, 1) %}
  {% elseif clip and film_layer|default('ground') == 'float' %}
    {% set layers = pictures|slice(0, 1)|merge([clip]) %}
  {% elseif clip %}
    {% set layers = [clip]|merge(pictures|slice(0, 1)) %}
  {% else %}
    {% set layers = pictures %}
  {% endif %}
{% endif %}
{% set layers = layers|filter(m => m.src is defined and m.src) %}
{% set classes = [
  'work-gallery__figure',
  layered ? 'work-gallery__figure--layered',
  style == 'layered_square' ? 'work-gallery__figure--square',
  style == 'portrait' ? 'work-gallery__figure--portrait',
  'media-reveal',
]|filter(v => v) %}
{# the inset is on the editor's scale — 0% none, 100% leaves nothing — and
   the CSS wants the inset from EACH edge, so half (user call, 16 Oct 2026);
   it goes out in cqi, not %: a % inset resolves against the frame's HEIGHT
   top and bottom and its WIDTH at the sides, so a 16:9 frame sat its cut-out
   closer to the top (user catch, 16 Oct 2026) — cqi is 1% of the frame's
   width on every side (the frame is an inline-size container). A value
   that is not a plain percentage passes through #}
{% set styles = [
  layered and ground ? '--overlay-ground: ' ~ ground,
  layered and pad ? '--overlay-pad: ' ~ (pad matches '/^\\s*\\d+(\\.\\d+)?\\s*%?\\s*$/' ? (pad|replace({'%': ''})|trim / 2) ~ 'cqi' : pad),
]|filter(v => v) %}
<figure class="{{ classes|join(' ') }}" data-reveal-img{% if styles %} style="{{ styles|join('; ') }}"{% endif %}>
  {% for m in layers %}
    {% if m.type is defined and m.type == 'video' %}
      {# preload="metadata", not "auto": a gallery of films fetched every body
         at once. Decorative — the figure's own caption and the article name
         the work (found in review, Sep 2026). #}
      <video autoplay muted loop playsinline preload="metadata" src="{{ m.src }}"{% if m.poster is defined and m.poster %} poster="{{ m.poster }}"{% endif %} aria-hidden="true"></video>
    {% else %}
      <img loading="lazy" src="{{ m.src }}" alt="{{ m.alt|default('') }}"{% if m.width is defined and m.width %} width="{{ m.width }}"{% endif %}{% if m.height is defined and m.height %} height="{{ m.height }}"{% endif %} />
    {% endif %}
  {% endfor %}
</figure>
