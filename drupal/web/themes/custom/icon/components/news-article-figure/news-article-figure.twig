{#
/**
 * @file
 * news-article-figure — THE picture (components/picture.css): one pick at
 * its own shape or a crop, on the site's corner, revealed on scroll; with a
 * cut-out, layered — the cut-out floating over the first pick or a ground
 * colour. One component for the article figure, the gallery figure and the
 * scroller's cards (Sep 2026).
 *
 * `picture` and `float` are the picks — a media id from Canvas, or the
 * resolved media from a theme path; `image` is what a figure placed before
 * carries (the news article's figure paragraph passes it too), still
 * honoured.
 */
#}
{% set ground_m = picture is defined and picture ? (picture is iterable ? picture : icon_media(picture, 'work_media')) : {} %}
{% set float_m = float is defined and float ? (float is iterable ? float : icon_media(float, 'work_media')) : {} %}
{% if ground_m.src is not defined and image.src is defined and image.src %}{% set ground_m = image|merge({ type: 'image' }) %}{% endif %}
{% set layered = float_m.src is defined and float_m.src %}
{% set shape = shape|default('natural') %}
{# parallax is on unless the editor turned it off (an instance placed before
   the prop carries none, and drifts) #}
{% set drift = parallax is not defined or parallax is same as(null) or parallax %}
{% set layers = (layered ? [ground_m, float_m] : [ground_m])|filter(m => m.src is defined and m.src) %}
{% set classes = [
  'picture',
  'picture--' ~ shape,
  layered ? 'picture--layered',
  drift ? 'picture--parallax',
  layers is empty ? 'picture--empty',
  'media-reveal',
]|filter(v => v) %}
{# the inset is on the editor's scale — 0% none, 100% leaves nothing — and
   the CSS wants the inset from EACH edge, so half (user call, 16 Oct 2026);
   it goes out in cqi, not %: a % inset resolves against the frame's HEIGHT
   top and bottom and its WIDTH at the sides, so a 16:9 frame sat its cut-out
   closer to the top (user catch, 16 Oct 2026) — cqi is 1% of the frame's
   width on every side (the frame is an inline-size container). A value
   that is not a plain percentage passes through #}
{% set styles = [
  layered and ground ? '--overlay-ground: ' ~ ground,
  layered and pad ? '--overlay-pad: ' ~ (pad matches '/^\\s*\\d+(\\.\\d+)?\\s*%?\\s*$/' ? (pad|replace({'%': ''})|trim / 2) ~ 'cqi' : pad),
]|filter(v => v) %}
<figure class="{{ classes|join(' ') }}" data-reveal-img{% if styles %} style="{{ styles|join('; ') }}"{% endif %}>
  {% for m in layers %}
    {% if m.type is defined and m.type == 'video' %}
      {# decorative — the article names the work; preload="metadata", not
         "auto": a row of films fetched every body at once #}
      <video autoplay muted loop playsinline preload="metadata" src="{{ m.src }}"{% if m.poster is defined and m.poster %} poster="{{ m.poster }}"{% endif %} aria-hidden="true"></video>
    {% else %}
      <img loading="lazy" src="{{ m.src }}" alt="{{ m.alt|default('') }}"{% if m.width is defined and m.width %} width="{{ m.width }}"{% endif %}{% if m.height is defined and m.height %} height="{{ m.height }}"{% endif %} />
    {% endif %}
  {% endfor %}
  {# nothing picked yet: on the page the figure is not drawn; in the editor
     it stands at a landscape's size so there is something to click and
     fill (user catch, 16 Oct 2026: a Picture dropped in a column was 0px
     high) #}
    {% if layers is empty %}<span class="picture__empty">{{ 'Pick a picture'|t }}</span>{% endif %}
</figure>
