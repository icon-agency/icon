{#
/**
 * @file
 * work-stats — the results band. The cells are work-stat components in the
 * `results` slot; the article's template fills it from the nested Result
 * paragraphs, a Canvas page by dropping Results in (Sep 2026 — it took an
 * `items` array of objects before, which Canvas cannot author).
 */
#}
<section class="work-stats" data-animate aria-label="{{ 'Results at a glance'|t }}">
  <dl class="work-stats__grid">
    {% block results %}{{ results }}{% endblock %}
  </dl>
</section>
