{#
/**
 * @file
 * hero — thin copy of the hero in templates/homeC.html. The loading screen
 * (.text-box) is built by js/hero-loader.js; the pile, headline device,
 * client label and counter are the markup js/home-c.js drives. The lockup is
 * the shared include (the same artwork the login page draws).
 *
 * ONE LIST, NOT TWO. The template writes every piece twice — a pile card in
 * .hero__stage and a reel slide in .hero__show-inner. Here each slide is a
 * Hero slide component rendered once, into the stage, and js/home-c.js
 * builds the reel from the pile when it finds the reel empty.
 */
#}
<section class="hero" data-hero>
  <div class="text-box text-box--cover text-box--pop" data-text-box aria-hidden="true"></div>

  <div class="hero__show" aria-hidden="true">
    <div class="hero__show-inner">
      {# the reel slides are cloned in here from the cards below, before the scrim #}
      <div class="hero__scrim"></div>
    </div>
  </div>

  <div class="hero__stage" aria-hidden="true">
    {# SLOT slides: Hero slide components, in reel order. #}
    {{ slides }}
  </div>

  <div class="hero__inner">
    <h1 class="hero__headline">
      <span class="sr-only">{{ 'Make what matters'|t }}</span>
      {% include '@icon/includes/lockup.html.twig' %}
    </h1>
  </div>

  <p class="hero__client" data-client-label></p>
  <p class="hero__count" data-boot-count aria-hidden="true"></p>
</section>
