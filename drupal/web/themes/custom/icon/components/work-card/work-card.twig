{#
/**
 * @file
 * work-card — thin copy of the project tile in templates/work-landing-b.html.
 * Root is the homepage's .work__item; reveal via .media-reveal (js/reveal.js),
 * tilt + lean by the host page (js/work-landing.js / js/home-c.js). With
 * `layers` (an old-site folio item) the media is the legacy layered tile —
 * .work__figure--legacy in src/utilities/home-c.css.
 */
#}
{% set tag = heading_level|default('h2') %}
<a class="work__item{{ wide ? ' work__item--wide' }}" href="{{ url }}" aria-label="{{ title }} — {{ client }}">
  {% if layers %}
    {# the legacy layered tile (old-site folio items): square cut-outs, back to front #}
    <figure class="work__figure work__figure--legacy media-reveal" data-reveal-img>
      <div class="work__layers">
        {% for layer in layers %}
          <span class="work__layer"><img class="work__img" loading="lazy" src="{{ layer.src }}" alt="{{ loop.first ? media.alt|default(client) : '' }}"{% if layer.width %} width="{{ layer.width }}"{% endif %}{% if layer.height %} height="{{ layer.height }}"{% endif %} /></span>
        {% endfor %}
      </div>
    </figure>
  {% else %}
  {# One tile, or two: with a wide tile the figure carries both and the frame's
     CSS shows the one its shape calls for (--tile-square / --tile-wide, set by
     the landscape rules in home-c.css and work-landing.css). A hidden variant
     costs nothing: images are lazy, and a film's src waits in data-src until
     js-theme/work-tile-variants.js sees which variant is showing. #}
  {% macro tile(m, variant, client, lazySrc) %}
    {% set cls = 'work__img' ~ (variant ? ' work__img--' ~ variant) %}
    {% if m.type == 'video' %}
      <video class="{{ cls }}"{% if lazySrc %} data-src="{{ m.src }}" preload="none"{% else %} src="{{ m.src }}" preload="auto"{% endif %}{% if m.poster %} poster="{{ m.poster }}"{% endif %} autoplay loop muted playsinline aria-label="{{ m.alt|default(client ~ ' — campaign film') }}"></video>
    {% else %}
      <img class="{{ cls }}" loading="lazy" src="{{ m.src }}" alt="{{ m.alt }}"{% if m.width %} width="{{ m.width }}"{% endif %}{% if m.height %} height="{{ m.height }}"{% endif %} />
    {% endif %}
  {% endmacro %}
  {% import _self as card %}
  {% set two = media_wide.src is defined and media_wide.src %}
  <figure class="work__figure{{ foreground.src ? ' work__figure--layered' }} media-reveal" data-reveal-img{% if two %} data-tile-variants{% endif %}{% if foreground.src and inset %} style="--overlay-pad: {{ inset }}"{% endif %}>
    {% if two %}
      {{ card.tile(media, 'square', client, true) }}
      {{ card.tile(media_wide, 'wide', client, true) }}
    {% else %}
      {{ card.tile(media, '', client, false) }}
    {% endif %}
    {% if foreground.src %}
      <img class="work__float" loading="lazy" src="{{ foreground.src }}" alt="{{ foreground.alt }}"{% if foreground.width %} width="{{ foreground.width }}"{% endif %}{% if foreground.height %} height="{{ foreground.height }}"{% endif %} />
    {% endif %}
  </figure>
  {% endif %}
  <div class="work__caption" data-animate{% if delay %} style="--animate-delay: {{ delay }}ms"{% endif %}>
    <{{ tag }} class="work__title">{{ title }}</{{ tag }}>
    <span class="work__meta">{{ client }}</span>
  </div>
</a>
