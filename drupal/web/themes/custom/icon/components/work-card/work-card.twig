{#
/**
 * @file
 * work-card — thin copy of the project tile in templates/work-landing-b.html.
 * Root is the homepage's .work__item; reveal via .media-reveal (js/reveal.js),
 * tilt + lean by the host page (js/work-landing.js / js/home-c.js).
 */
#}
{% set tag = heading_level|default('h2') %}
<a class="work__item{{ wide ? ' work__item--wide' }}" href="{{ url }}" aria-label="{{ title }} — {{ client }}">
  <figure class="work__figure media-reveal" data-reveal-img>
    {% if media.type == 'video' %}
      <video class="work__img" src="{{ media.src }}" autoplay loop muted playsinline preload="auto" aria-label="{{ media.alt|default(client ~ ' — campaign film') }}"></video>
    {% else %}
      <img class="work__img" loading="lazy" src="{{ media.src }}" alt="{{ media.alt }}"{% if media.width %} width="{{ media.width }}"{% endif %}{% if media.height %} height="{{ media.height }}"{% endif %} />
    {% endif %}
  </figure>
  <div class="work__caption" data-animate{% if delay %} style="--animate-delay: {{ delay }}ms"{% endif %}>
    <{{ tag }} class="work__title">{{ title }}</{{ tag }}>
    <span class="work__meta">{{ client }}</span>
  </div>
</a>
