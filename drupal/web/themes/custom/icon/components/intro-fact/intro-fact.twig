{# intro-fact — a filmstrip fact card (components/filmstrip.css .filmstrip__card--fact). The icon is an Icon media item (SVG, fill=currentColor), inlined by icon_site's icon_inline_svg(). #}
<div class="filmstrip__card filmstrip__card--fact">
  {{ icon_inline_svg(icon, 'filmstrip__fact-icon') }}
  <p class="filmstrip__fact-title">{{ title }}</p>
  {% if label %}<p class="filmstrip__fact-label" data-rule="top">{{ label }}</p>{% endif %}
</div>
