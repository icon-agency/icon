{#
/**
 * @file
 * team-profiles — the grid and the panel (src/components/team-profiles.css,
 * js/team-profiles.js).
 *
 * The grid: one link per member, to the panel's own address (base/slug), so
 * without JS it is still a link to a page that shows the About page. The
 * panel: ONE <dialog> holding every profile, one shown at a time — the
 * behaviour swaps them, writes the address to the history, and reads a
 * deep link back on load.
 */
#}
{% set n = members|length %}
<section class="team"{% if heading %} aria-labelledby="team-heading"{% else %} aria-label="{{ 'Team'|t }}"{% endif %}>
  {% if heading %}<h2 class="team__heading" id="team-heading" data-animate>{{ heading }}</h2>{% endif %}
  <ul class="team__grid">
    {% for m in members %}
      <li class="team__member" data-animate{% if not loop.first %} style="--animate-delay: {{ (loop.index0 % 3) * 70 }}ms"{% endif %}>
        <a class="team__link" href="{{ base }}/{{ m.slug }}" data-team-open="{{ m.slug }}">
          <figure class="team__figure">
            <div class="team__frame media-reveal" data-reveal-img>
              {% if m.photo.src %}
                <img class="team__photo" src="{{ m.photo.src }}" alt=""{% if m.photo.width %} width="{{ m.photo.width }}"{% endif %}{% if m.photo.height %} height="{{ m.photo.height }}"{% endif %} loading="lazy" />
              {% endif %}
            </div>
          </figure>
          <span class="team__name">{{ m.name }}</span>
          <span class="team__role">{{ m.role }}</span>
          <span class="team__plus" aria-hidden="true">+</span>
        </a>
      </li>
    {% endfor %}
  </ul>

  <dialog class="team-overlay" data-team-overlay data-team-base="{{ base }}" aria-label="{{ 'Team member'|t }}">
    <div class="team-overlay__panel">
      <div class="team-overlay__bar">
        <div class="team-overlay__steps">
          <button class="team-overlay__arrow" type="button" data-team-prev aria-label="{{ 'Previous'|t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4" /><path d="m10 6-6 6 6 6" /></svg>
          </button>
          <button class="team-overlay__arrow" type="button" data-team-next aria-label="{{ 'Next'|t }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16" /><path d="m14 6 6 6-6 6" /></svg>
          </button>
          <span class="team-overlay__counter" aria-live="polite"><span data-team-index>01</span><span class="team-overlay__of">/{{ '%02d'|format(n) }}</span></span>
        </div>
        <button class="team-overlay__close" type="button" data-team-close aria-label="{{ 'Close'|t }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
        </button>
      </div>
      {% for m in members %}
        <article class="team-overlay__profile" data-team-profile="{{ m.slug }}" hidden>
          {# The portrait tilts toward the cursor (the figure); the media
             mask draws the photo in (the frame, the shared .media-reveal —
             its own box, never the tilted one, per LESSONS.md). #}
          <figure class="team-overlay__portrait">
            <div class="team-overlay__frame media-reveal" data-reveal-img>
              {% if m.photo.src %}
                <img src="{{ m.photo.src }}" alt="{{ m.photo.alt }}"{% if m.photo.width %} width="{{ m.photo.width }}"{% endif %}{% if m.photo.height %} height="{{ m.photo.height }}"{% endif %} loading="lazy" />
              {% endif %}
            </div>
          </figure>
          <div class="team-overlay__text">
            {# the site's entrances: the word cascade on the name, the rise
               on the rest, re-armed by js/team-profiles.js on every step #}
            <h2 class="team-overlay__name" data-reveal-words><span data-team-name>{{ m.name }}</span> <span class="team-overlay__role">{{ m.role }}</span></h2>
            {# raw: the block hands over the text format's processed output,
               already run through the format's filters (basic_html) — the
               same HTML the prose component prints, as a string because the
               prop sits inside a list. #}
            <div class="team-overlay__bio" data-animate style="--animate-delay: 250ms">{{ m.bio|raw }}</div>
            {% if m.linkedin %}
              <a class="team-overlay__linkedin" href="{{ m.linkedin }}" rel="noopener" target="_blank" data-animate style="--animate-delay: 400ms">{{ 'Connect on LinkedIn'|t }}</a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </dialog>
</section>
