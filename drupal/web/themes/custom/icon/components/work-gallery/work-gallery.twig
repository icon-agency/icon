{#
/**
 * @file
 * work-gallery — thin copy of the gallery blocks in templates/work-article-master.html.
 * A row is one or two FIGURES (--cols-2 for a pair). A plain figure is one
 * picture; portrait crops it to 7:10; a layered figure is a float (its last
 * media) over a ground (its first, or --overlay-ground), wide or square.
 */
#}
{% macro medium(m, extra) %}
  {% if m.type == 'video' %}
    <video autoplay muted loop playsinline preload="auto" src="{{ m.src }}"{% if m.poster %} poster="{{ m.poster }}"{% endif %}{% if m.alt %} aria-label="{{ m.alt }}"{% endif %}></video>
  {% else %}
    <img loading="lazy" src="{{ m.src }}" alt="{{ m.alt }}"{% if m.width %} width="{{ m.width }}"{% endif %}{% if m.height %} height="{{ m.height }}"{% endif %} />
  {% endif %}
{% endmacro %}
{% import _self as gallery %}
<div class="work-gallery">
  {% for row in rows %}
    <div class="work-gallery__row{{ row.figures|length > 1 ? ' work-gallery__row--cols-2' }}">
      {% for f in row.figures %}
        {% set layered = f.style starts with 'layered' %}
        {% set classes = [
          layered ? 'work-gallery__figure--layered',
          f.style == 'layered_square' ? 'work-gallery__figure--square',
          f.style == 'portrait' ? 'work-gallery__figure--portrait',
          'media-reveal',
        ]|filter(v => v) %}
        {% set styles = [
          layered and f.ground ? '--overlay-ground: ' ~ f.ground,
          layered and f.pad ? '--overlay-pad: ' ~ f.pad,
          not loop.first ? '--animate-delay: 60ms',
        ]|filter(v => v) %}
        <figure class="{{ classes|join(' ') }}" data-reveal-img{% if styles %} style="{{ styles|join('; ') }}"{% endif %}>
          {% for m in (layered ? f.media : f.media|slice(0, 1)) %}{{ gallery.medium(m) }}{% endfor %}
        </figure>
      {% endfor %}
    </div>
  {% endfor %}
</div>
