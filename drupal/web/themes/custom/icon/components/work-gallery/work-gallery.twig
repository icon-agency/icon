{#
/**
 * @file
 * work-gallery — thin copy of the gallery blocks in templates/work-article-master.html.
 * A row with two media is --cols-2; the portrait style crops both to 7:10;
 * a layered row is ONE figure: ground (first media or --overlay-ground) + float (last).
 */
#}
{% macro medium(m, extra) %}
  {% if m.type == 'video' %}
    <video autoplay muted loop playsinline preload="auto" src="{{ m.src }}"{% if m.alt %} aria-label="{{ m.alt }}"{% endif %}></video>
  {% else %}
    <img loading="lazy" src="{{ m.src }}" alt="{{ m.alt }}"{% if m.width %} width="{{ m.width }}"{% endif %}{% if m.height %} height="{{ m.height }}"{% endif %} />
  {% endif %}
{% endmacro %}
{% import _self as gallery %}
<div class="work-gallery">
  {% for row in rows %}
    {% if row.style == 'layered' %}
      {% set styles = [row.ground ? '--overlay-ground: ' ~ row.ground, row.pad ? '--overlay-pad: ' ~ row.pad]|filter(v => v) %}
      <div class="work-gallery__row">
        <figure class="work-gallery__figure--layered media-reveal" data-reveal-img{% if styles %} style="{{ styles|join('; ') }}"{% endif %}>
          {% for m in row.media %}{{ gallery.medium(m) }}{% endfor %}
        </figure>
      </div>
    {% else %}
      <div class="work-gallery__row{{ row.media|length > 1 ? ' work-gallery__row--cols-2' }}">
        {% for m in row.media %}
          <figure class="{{ row.style == 'portrait' ? 'work-gallery__figure--portrait ' }}media-reveal" data-reveal-img{% if not loop.first %} style="--animate-delay: 60ms"{% endif %}>
            {{ gallery.medium(m) }}
          </figure>
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}
</div>
