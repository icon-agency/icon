{#
/**
 * @file
 * testimonial — one quote of the carousel (components/testimonials.css):
 * a two-column article, the person on the left — name, then their role,
 * then their company, a line each — with the mark at the foot
 * (margin-top: auto), the quote on the right. The mark is always one
 * colour (user call, Sep 2026: "the logo should never be colour"): a CSS
 * mask over the ink, so any logo — black on white, a full-colour PNG —
 * reads as the box's ink on any ground. Its source is icon_media(): a
 * Logo (file) or a picture.
 */
#}
{% set mark = logo ? icon_media(logo, 'work_media') : [] %}
<article class="testimonial" data-testimonial>
  <div class="testimonial__who">
    {% if name or role or company %}
      <p class="testimonial__person">
        {% if name %}<span class="testimonial__name">{{ name }}</span>{% endif %}
        {% if role %}<span class="testimonial__role">{{ role }}</span>{% endif %}
        {% if company %}<span class="testimonial__company">{{ company }}</span>{% endif %}
      </p>
    {% endif %}
    {% if mark.src %}
      <span class="testimonial__logo testimonial__logo--mono{% if logo_large %} testimonial__logo--large{% endif %}" style="--logo: url('{{ mark.src|e('css') }}')" role="img" aria-label="{{ mark.alt|default(company|default('')) }}"></span>
    {% endif %}
  </div>
  {# The quotation marks are the template's (user question, 22 Sep 2026:
     "They need to add quotation marks? Or we automatically put them in?"):
     typographic, round the words; any typed at the edges — straight or
     curly — are shed first so an older quote is not doubled. #}
  {% set said = quote|default('')|trim|trim('"\u{201C}\u{201D}')|trim %}
  <blockquote class="testimonial__quote">
    <p>&ldquo;{{ said|nl2br }}&rdquo;</p>
  </blockquote>
</article>
