{#
/**
 * @file
 * The page: skip link, the site header, <main>, the site footer — the shell
 * every static template shares (templates/*.html). The header and footer are
 * includes, not regions (see icon.info.yml). `main_attributes` comes from
 * icon_preprocess_page() and is where a page layer adds its shell class
 * (`.page-home` on the homepage).
 *
 * Available variables: page.highlighted (status messages), page.content;
 * work_frame (the Canvas editor building a Work article, see below).
 */
#}
<a class="sr-only skip-link" href="#main">{{ 'Skip to content'|t }}</a>
{% include '@icon/includes/site-header.html.twig' %}
<main{{ main_attributes }}>
  {# the extension point a page--403 / page--404 template overrides #}
  {% block content %}
    {{ page.highlighted }}
    {% if work_frame %}
      {# The Canvas editor building a Work article: the frame the node
         template composes on the page, composed here around the body the
         editor is showing — from the DRAFT node, so a client or category
         edited in Page data reads in the masthead at once
         (icon_preprocess_page(), includes/work-frame.html.twig). #}
      <article class="work-article" aria-labelledby="project-title">
        {% include '@icon/includes/work-frame.html.twig' with work_frame|merge({ editor: true }) only %}
        <div class="work-article__flow">{{ page.content }}</div>
        <div class="work-article__share-footer">{% include '@icon/includes/share.html.twig' %}</div>
      </article>
    {% else %}
      {{ page.content }}
    {% endif %}
  {% endblock %}
</main>
{% include '@icon/includes/site-footer.html.twig' %}
