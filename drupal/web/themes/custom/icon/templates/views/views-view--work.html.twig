{#
/**
 * @file
 * The /work landing — thin copy of templates/work-landing-b.html: the
 * page-header--stack masthead (the dark opening's handover hook rides it),
 * the six category chips (from icon_preprocess_views_view()), the uncapped
 * project grid (views-view-unformatted--work.html.twig) and the pager.
 */
#}
<div class="page-header page-header--stack" data-theme-handover>
  <div class="page-header__inner">
    <h1 class="page-header__heading page-header__heading--lockup" data-animate>
      <span class="page-header__lockup-accent masthead-accent">{{ 'Work'|t }}</span>
      <span class="page-header__lockup-caps">{{ 'Selected work and case studies'|t }}</span>
    </h1>
    <div class="page-header__subscribe-slot" data-subscribe-slot data-animate style="--animate-delay: 80ms">
      <div class="page-header__subscribe-closed">
        <div class="page-header__slot-clip">
          <button class="page-header__subscribe quiet-link invite-arrow" type="button" data-subscribe-open aria-expanded="false">{{ 'Subscribe'|t }}</button>
        </div>
      </div>
      <div class="page-header__subscribe-reveal">
        <div class="page-header__slot-clip">
          <label class="sr-only" for="header-email">{{ 'Email address'|t }}</label>
          <div class="page-header__email-row">
            <input class="page-header__email" id="header-email" type="email" name="email" placeholder="{{ 'Your email'|t }}" autocomplete="email" />
            <button class="page-header__email-go invite-arrow" type="button" data-subscribe aria-label="{{ 'Subscribe'|t }}"></button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="page-header__filter-band" data-rule="both">
    <div class="page-header__filters">
      <div class="filter-bar" role="group" aria-label="{{ 'Filter work by category'|t }}">
        {% for chip in chips %}
          <a class="filter-bar__chip{{ chip.active ? ' is-active' }}" href="{{ chip.url }}" data-filter="{{ chip.key }}"{% if chip.active %} aria-current="true"{% endif %}>{{ chip.label }}</a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<section class="work-landing__projects u-container" aria-label="{{ 'Work projects'|t }}">
  <p class="sr-only" aria-live="polite" data-work-status></p>
  {{ rows }}
  {{ empty }}
  {{ pager }}
</section>
