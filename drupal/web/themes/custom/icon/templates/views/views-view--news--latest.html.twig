{#
/**
 * @file
 * The homepage news rail (templates/homeC.html .news): the Latest / News
 * lockup, More, three cards.
 */
#}
<section class="news u-container" aria-label="{{ 'Latest news'|t }}">
  <div class="news__inner">
    <div class="news__head">
      <div class="news__rail">
        <h2 class="news__heading reveal-lines" data-animate>
          <span class="reveal-lines__line lockup-accent masthead-accent"><span class="reveal-lines__word" style="--w: 0">{{ 'Latest'|t }}</span></span>
          <span class="reveal-lines__line lockup-caps"><span class="reveal-lines__word" style="--w: 1">{{ 'News'|t }}</span></span>
        </h2>
      </div>
      <a class="news__more invite-arrow" href="{{ path('view.news.page_1') }}" aria-label="{{ 'More news'|t }}">{{ 'More'|t }}</a>
    </div>
    {{ rows }}
  </div>
</section>
