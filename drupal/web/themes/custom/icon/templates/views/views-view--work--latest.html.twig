{#
/**
 * @file
 * The "Latest work" rail — the Next up rail for any page (the Digital
 * expertise page first, Sep 2026), the newest work items: the two-voice
 * lockup, the work cards, More. The heading's two lines and where More
 * goes are the Work: latest block's settings, read off the display in
 * icon_preprocess_views_view() (user ask, Sep 2026: "allow me to page edit
 * this heading … select what is in the feed"); the bare Views block gets
 * "Latest" over "Work" and all work. Still on the client theme — the
 * footer alone returns to the site theme.
 */
#}
{# nothing in the feed — a category with no work yet — is no rail at all,
   not a heading over nothing #}
{% set cards = rows|render %}
{% if cards|striptags|trim %}
<section class="work-article__next" data-rule="top" aria-label="{{ heading_accent ~ ' ' ~ heading_caps }}">
  <h2 class="work-article__next-heading reveal-lines" data-animate>
    <span class="reveal-lines__line lockup-accent masthead-accent"><span class="reveal-lines__word" style="--w: 0">{{ heading_accent }}</span></span>
    <span class="reveal-lines__line lockup-caps"><span class="reveal-lines__word" style="--w: 1">{{ heading_caps }}</span></span>
  </h2>
  {{ cards }}
  <div class="work-article__next-more">
    <a class="news__more invite-arrow" href="{{ more_url|default(path('<front>') ~ 'work') }}" aria-label="{{ 'More work'|t }}">{{ 'More'|t }}</a>
  </div>
</section>
{% endif %}
