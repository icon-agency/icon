{#
/**
 * @file
 * The /news listing — thin copy of templates/news-b.html (header B: the
 * centred page-header--stack masthead over the paired list).
 *
 * The masthead and chips live here, not in a Views header: the chips are
 * the View's category argument rendered as links (icon_preprocess_views_view
 * builds `chips` from the field's allowed values + the ?category param), so
 * they filter server-side and js/news.js enhances them in place. `rows` is
 * views-view-unformatted--news.html.twig; `pager` is the themed pager.
 */
#}
<div class="page-header page-header--stack">
  <div class="page-header__inner">
    <h1 class="page-header__heading page-header__heading--lockup" data-animate>
      <span class="page-header__lockup-accent masthead-accent">{{ 'News'|t }}</span>
      <span class="page-header__lockup-caps">{{ 'The latest updates and insights'|t }}</span>
    </h1>
    <!-- Subscribe: the search face's twin (page-header.css "the Subscribe bar"); the field hints Subscribe, then Your email on hover (js/subscribe-reveal.js) -->
    <div class="page-header__subscribe-bar subscribe-bar" data-subscribe-bar data-animate style="--animate-delay: 80ms">
      <span class="subscribe-bar__glyph" aria-hidden="true"><svg class="subscribe-bar__svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 8 9 6 9-6" /></svg></span>
      <label class="sr-only" for="header-email">{{ 'Email address'|t }}</label>
      <input class="subscribe-bar__input" id="header-email" type="email" name="email" placeholder="{{ 'Subscribe'|t }}" autocomplete="email" data-subscribe-input data-hint-rest="{{ 'Subscribe'|t }}" data-hint-hover="{{ 'Your email'|t }}">
      <button class="subscribe-bar__go" type="button" data-subscribe aria-label="{{ 'Subscribe'|t }}"><svg class="subscribe-bar__svg" viewBox="4 4 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 5v10h12" /><path d="m14 11 4 4-4 4" /></svg></button>
    </div>
  </div>

  <div class="page-header__filter-band page-header__filter-band--open" data-rule="top">
    <div class="page-header__filters">
      <div class="filter-bar" role="group" aria-label="{{ 'Filter news by category'|t }}">
        {% for chip in chips %}
          <a class="filter-bar__chip{{ chip.active ? ' is-active' }}" href="{{ chip.url }}" data-filter="{{ chip.key }}"{% if chip.active %} aria-current="true"{% endif %}>{{ chip.label }}</a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<section aria-label="{{ 'News stories'|t }}">
  <p class="sr-only" aria-live="polite" data-news-status></p>
  {{ rows }}
  {{ empty }}
  {{ pager }}
</section>
