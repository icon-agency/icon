{#
/**
 * @file
 * Drupal's status messages as TOASTS (src/toast.css, js-theme/toast.js):
 * a stack of dark pills in the bottom-left corner, clear of the wordmark,
 * the nav and the admin sidebar, each with a close control. Statuses
 * dismiss themselves after a few seconds; warnings and errors stay until
 * closed. Core's contract is kept where it is load-bearing —
 * data-drupal-messages (the container Drupal.Message appends JS-added
 * messages to) and the status/alert roles — so assistive tech behaves as
 * on any Drupal site. The classes are this design system's own.
 * The account pages restyle the same markup inline (src/auth.css).
 */
#}
<div{{ attributes.addClass('toast').setAttribute('data-drupal-messages', '') }}>
  {% for type, messages in message_list %}
    {# create_attribute, not the shared `attributes`: addClass() MUTATES the
       one object, so with two kinds of message on the page the second toast
       kept the first's modifier and was painted as the wrong kind (found in
       review, Sep 2026). #}
    <div{{ create_attribute({'class': ['toast__item', 'toast__item--' ~ type], 'role': type == 'error' ? 'alert' : 'status', 'data-toast': type}) }}>
      {% if status_headings[type] %}
        <h2 class="sr-only">{{ status_headings[type] }}</h2>
      {% endif %}
      <div class="toast__text">
        {% if messages|length > 1 %}
          <ul class="toast__list">
            {% for message in messages %}
              <li>{{ message }}</li>
            {% endfor %}
          </ul>
        {% else %}
          {{ messages|first }}
        {% endif %}
      </div>
      <button class="toast__close" type="button" aria-label="{{ 'Dismiss'|t }}" data-toast-close>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
      </button>
    </div>
  {% endfor %}
</div>
