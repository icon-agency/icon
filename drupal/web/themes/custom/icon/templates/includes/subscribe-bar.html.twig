{#
/**
 * @file
 * The masthead's Subscribe bar — the search face's twin
 * (src/components/subscribe-bar.css): the field hints Subscribe, then Your
 * email on hover, and opens on focus (js/subscribe-reveal.js). The footer
 * wears the same block in its own variant.
 *
 * One copy. It was written out twice, in the /work and /news masthead
 * templates, ten identical lines each (found in review, Sep 2026).
 */
#}
<!-- Subscribe: the search face's twin (page-header.css "the Subscribe bar"); the field hints Subscribe, then Your email on hover (js/subscribe-reveal.js) -->
<div class="page-header__subscribe-bar subscribe-bar" data-subscribe-bar data-animate style="--animate-delay: 80ms">
  <span class="subscribe-bar__glyph" aria-hidden="true"><svg class="subscribe-bar__svg subscribe-bar__svg--mail" viewBox="2 4 20 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 8 9 6 9-6" /></svg></span>
  <label class="sr-only" for="header-email">{{ 'Email address'|t }}</label>
  <span class="subscribe-bar__field">
    <input class="subscribe-bar__input" id="header-email" type="email" name="email" placeholder=" " autocomplete="email" data-subscribe-input>
    <span class="subscribe-bar__hint" aria-hidden="true"><span class="subscribe-bar__hint-rest">{{ 'Subscribe'|t }}</span><span class="subscribe-bar__hint-hover">{{ 'Your email'|t }}</span></span>
  </span>
  <button class="subscribe-bar__go" type="button" data-subscribe aria-label="{{ 'Subscribe'|t }}"><svg class="subscribe-bar__svg" viewBox="4 4 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 5v10h12" /><path d="m14 11 4 4-4 4" /></svg></button>
</div>
