{#
/**
 * @file
 * The site header — the global chrome, ported from templates/news-b.html
 * (identical on every template; the canonical homeC labels the drawer
 * trigger EXPERTISE, which is used here). Hand-authored Twig, not a block
 * region: this markup IS src/components/site-header.css's contract.
 *
 * Behaviour: Drupal.behaviors.iconHeader (icon/header) — scroll state,
 * mobile menu, drawer offset. The SERVICES drawer is CSS-driven.
 *
 * The links are the Main navigation menu (`nav`, icon_preprocess_page() via
 * icon_site_primary_nav(); Structure → Menus → Main navigation): the pill
 * prints the top level in caps, the first link with children opens the
 * drawer of them, and the mobile menu prints the same two lists (user
 * ask, Sep 2026: "Where do I manage this?"). Still static: aria-current
 * on the active item.
 */
#}
{% set front = path('<front>') %}
<header class="site-header">
  <!-- Wordmark, fixed top-left -->
  {# The four "home" controls all point at the front page — the prototype
     pointed them at the design-system index (docs/drupal-handoff.md). #}
  <a class="site-logo" href="{{ front }}" aria-label="{{ 'ICON Agency — home'|t }}">
    <svg
      class="site-logo__mark"
      viewBox="0 0 154 50"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-hidden="true"
    >
      <path d="M153.042 18.4117L148.607 14.7183H142.101C140.042 14.7183 138.367 13.0435 138.367 10.9848V0H149.309C151.367 0 153.042 1.67487 153.042 3.73356V18.4117ZM139.902 1.53434V10.9848C139.902 12.1974 140.888 13.184 142.101 13.184H149.162L151.508 15.1374V3.73356C151.508 2.52088 150.521 1.53434 149.309 1.53434H139.902Z" fill="currentColor" />
      <path d="M80.7421 29.5428C80.7421 34.619 76.6127 38.7489 71.5366 38.7489C66.4604 38.7489 62.3305 34.619 62.3305 29.5428C62.3305 24.4665 66.4602 20.3372 71.5366 20.3372C76.6129 20.3372 80.7421 24.4668 80.7421 29.5428ZM91.8734 29.543C91.8734 18.3293 82.7503 9.20605 71.5363 9.20605C60.3222 9.20605 51.1992 18.3293 51.1992 29.543C51.1992 40.7567 60.3222 49.8802 71.5363 49.8802C82.7503 49.8802 91.8734 40.7567 91.8734 29.543Z" fill="currentColor" />
      <path d="M37.7394 9.20606C26.5256 9.20606 17.4023 18.3293 17.4023 29.5431C17.4023 40.7569 26.5256 49.8802 37.7394 49.8802C42.5976 49.8802 47.3 48.115 51.009 44.9045L44.4842 36.366C42.67 38.1648 40.2872 39.1512 37.7394 39.1512C32.4416 39.1512 28.1316 34.841 28.1316 29.5431C28.1316 24.2453 32.4416 19.935 37.7394 19.935C40.3244 19.935 42.7325 20.9469 44.5542 22.7911L51.1997 14.3433C47.4621 11.0286 42.6924 9.20606 37.7394 9.20606Z" fill="currentColor" />
      <path d="M12.8008 9.20605H0V49.8802H12.8008V9.20605Z" fill="currentColor" />
      <path d="M121.726 9.20605V28.158L107.498 9.20605H96.4766V49.8802H108.513V30.9753L123.827 49.8802H133.763V9.20605H121.726Z" fill="currentColor" />
    </svg>
  </a>

  <!-- Desktop pill nav — expands downward into a drawer for SERVICES -->
  <div class="site-nav" data-nav>
    <div class="site-nav__cube" data-search-cube>
    <nav class="site-nav__pill site-nav__pill--nav" aria-label="{{ 'Primary'|t }}" data-search-front>
      <div class="site-nav__row">
        <a class="site-nav__home" href="{{ front }}" aria-label="{{ 'Home'|t }}">
          <svg class="site-nav__home-glyph" viewBox="0 0 64 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M63.5616 80L44.3508 63.9521H16.1712C7.25435 63.9521 0 56.6747 0 47.7297V0H47.3305C56.3073 0 63.5616 7.27741 63.5616 16.2226V80ZM6.64572 6.6668V47.7297C6.64572 52.9987 10.9187 57.2853 16.1712 57.2853H46.7556L56.916 65.7731V16.2226C56.916 10.9534 52.6429 6.6668 47.3905 6.6668H6.64572Z" fill="currentColor" />
          </svg>
        </a>
        <ul class="site-nav__list">
          {% set drawer = null %}
          {% for item in nav %}
            {% if item.children and not drawer %}
              {% set drawer = item %}
              {# The item with children is a BUTTON that opens the drawer, not a
                 link (user call, 23 Sep 2026): its page is the drawer's first
                 row — "Our approach" — so nothing is lost. #}
              <li class="site-nav__item site-nav__item--has-submenu" data-submenu-item>
                <button
                  class="site-nav__link"
                  type="button"
                  data-submenu-trigger
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls="nav-services"
                  >{{ item.title|upper }}</button
                >
              </li>
            {% else %}
              <li class="site-nav__item"><a class="site-nav__link" href="{{ item.url }}">{{ item.title|upper }}</a></li>
            {% endif %}
          {% endfor %}
          <li class="site-nav__item site-nav__item--search">
            <button class="site-nav__search-trigger" type="button" aria-label="{{ 'Open search'|t }}" aria-expanded="false" aria-controls="nav-search" data-search-open>
              <svg class="site-nav__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="8.5" /><path d="m21.5 21.5-5-5" /></svg>
            </button>
          </li>
        </ul>
        {# The phone's menu button (user call, 23 Sep 2026): below md the pill
           rests as this square — two lines — at the top right, and opens into
           the row (links, search, the home glyph at the right). Hidden from
           md; js/header.js opens it, and a tap outside, a scroll, a link or
           Esc closes it. #}
        <button class="site-nav__burger" type="button" aria-label="{{ 'Open menu'|t }}" aria-expanded="false" data-nav-burger>
          <svg class="site-nav__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" aria-hidden="true"><path d="M3 8h18" /><path d="M3 16h18" /></svg>
        </button>
      </div>

      <!-- Drawer: grows the pill downward; items align under the trigger -->
      {% if drawer %}
      <div class="site-nav__drawer" id="nav-services" data-submenu-drawer>
        <div class="site-nav__drawer-inner">
          <ul class="site-nav__submenu-list">
            {% for child in drawer.children %}
              <li><a class="site-nav__submenu-link" href="{{ child.url }}">{{ child.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>
      {% endif %}
    </nav>
    <!-- Search face: rolls in when the pill flips (site-header.css, "Search flip") -->
    <form class="site-nav__pill site-nav__pill--search" id="nav-search" role="search" action="{{ path('search.view_node_search') }}" method="get" data-search-face inert>
      <button class="site-nav__search-submit" type="submit" aria-label="{{ 'Search'|t }}">
        <svg class="site-nav__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="8.5" /><path d="m21.5 21.5-5-5" /></svg>
      </button>
      <input class="site-nav__search-input" type="search" name="keys" placeholder="{{ 'Search'|t }}" aria-label="{{ 'Search'|t }}" autocomplete="off" data-search-input>
      <button class="site-nav__search-close" type="button" aria-label="{{ 'Close search'|t }}" data-search-close>
        <svg class="site-nav__glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" /></svg>
      </button>
    </form>
    </div>
  </div>

  <!-- Mobile home glyph (appears on scroll) -->
  <div class="site-header__mobile-home" data-mobile-home>
    <a class="icon-button" href="{{ front }}" aria-label="{{ 'Home'|t }}">
      <svg class="icon-button__icon" viewBox="0 0 64 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M63.5616 80L44.3508 63.9521H16.1712C7.25435 63.9521 0 56.6747 0 47.7297V0H47.3305C56.3073 0 63.5616 7.27741 63.5616 16.2226V80ZM6.64572 6.6668V47.7297C6.64572 52.9987 10.9187 57.2853 16.1712 57.2853H46.7556L56.916 65.7731V16.2226C56.916 10.9534 52.6429 6.6668 47.3905 6.6668H6.64572Z" fill="currentColor" />
      </svg>
    </a>
  </div>

  <!-- Mobile contact + hamburger -->
  <div class="site-header__mobile-actions">
    <a class="icon-button" href="/contact" aria-label="{{ 'Contact'|t }}">
      <svg class="icon-button__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0Z" />
        <circle cx="12" cy="10" r="3" />
      </svg>
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="{{ 'Open menu'|t }}"
      data-menu-toggle
    >
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
    </button>
  </div>

  <!-- Full-screen mobile menu -->
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="mobile-menu__bg" aria-hidden="true"></div>
    <div class="mobile-menu__inner">
      <a class="mobile-menu__logo" href="{{ front }}" aria-label="{{ 'ICON Agency — home'|t }}">
        <svg class="site-logo__mark" viewBox="0 0 154 50" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M153.042 18.4117L148.607 14.7183H142.101C140.042 14.7183 138.367 13.0435 138.367 10.9848V0H149.309C151.367 0 153.042 1.67487 153.042 3.73356V18.4117ZM139.902 1.53434V10.9848C139.902 12.1974 140.888 13.184 142.101 13.184H149.162L151.508 15.1374V3.73356C151.508 2.52088 150.521 1.53434 149.309 1.53434H139.902Z" fill="currentColor" />
          <path d="M80.7421 29.5428C80.7421 34.619 76.6127 38.7489 71.5366 38.7489C66.4604 38.7489 62.3305 34.619 62.3305 29.5428C62.3305 24.4665 66.4602 20.3372 71.5366 20.3372C76.6129 20.3372 80.7421 24.4668 80.7421 29.5428ZM91.8734 29.543C91.8734 18.3293 82.7503 9.20605 71.5363 9.20605C60.3222 9.20605 51.1992 18.3293 51.1992 29.543C51.1992 40.7567 60.3222 49.8802 71.5363 49.8802C82.7503 49.8802 91.8734 40.7567 91.8734 29.543Z" fill="currentColor" />
          <path d="M37.7394 9.20606C26.5256 9.20606 17.4023 18.3293 17.4023 29.5431C17.4023 40.7569 26.5256 49.8802 37.7394 49.8802C42.5976 49.8802 47.3 48.115 51.009 44.9045L44.4842 36.366C42.67 38.1648 40.2872 39.1512 37.7394 39.1512C32.4416 39.1512 28.1316 34.841 28.1316 29.5431C28.1316 24.2453 32.4416 19.935 37.7394 19.935C40.3244 19.935 42.7325 20.9469 44.5542 22.7911L51.1997 14.3433C47.4621 11.0286 42.6924 9.20606 37.7394 9.20606Z" fill="currentColor" />
          <path d="M12.8008 9.20605H0V49.8802H12.8008V9.20605Z" fill="currentColor" />
          <path d="M121.726 9.20605V28.158L107.498 9.20605H96.4766V49.8802H108.513V30.9753L123.827 49.8802H133.763V9.20605H121.726Z" fill="currentColor" />
        </svg>
      </a>
      <div class="mobile-menu__cols">
        <nav class="mobile-menu__nav" aria-label="{{ 'Mobile primary'|t }}">
          {% for item in nav %}
            <a class="mobile-menu__link" href="{{ item.url }}">{{ item.title }}</a>
          {% endfor %}
        </nav>
        {% if drawer %}
        <nav class="mobile-menu__services" aria-label="{{ drawer.title }}">
          {% for child in drawer.children %}
            <a class="mobile-menu__service" href="{{ child.url }}">{{ child.title|upper }}</a>
          {% endfor %}
        </nav>
        {% endif %}
      </div>
      <div class="mobile-menu__social">
        <button class="mobile-menu__social-link" type="button" data-subscribe>Subscribe</button>
        <a class="mobile-menu__social-link" href="https://www.linkedin.com/company/iconagency" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="mobile-menu__social-link" href="https://www.instagram.com/iconagency" target="_blank" rel="noopener noreferrer">Instagram</a>
      </div>
    </div>
  </div>
</header>
