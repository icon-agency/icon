              <span class="site-footer__office-city">Brisbane</span>
              <span class="site-footer__office-place">Meanjin</span>
              <span class="site-footer__office-toggle" aria-hidden="true"></span>
            </summary>
            <address class="site-footer__office-details">
              <p>25 King Street<br />Bowen Hills<br />Brisbane QLD 4006 Australia</p>
              <p class="site-footer__office-contact">Phone <a href="tel:+61731556528">07 3155 6528</a><br /><a href="mailto:brisbane@iconagency.com.au">brisbane@iconagency.com.au</a></p>
            </address>
          </details>
        </li>
        <li class="site-footer__office-item" data-rule="both">
          <details class="site-footer__office">
            <summary class="site-footer__office-summary">
              <!-- footer-fiji-icon.tsx, inlined; fill follows currentColor -->
