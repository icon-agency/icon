{#
/**
 * @file
 * The global footer — ported from templates/news-b.html (byte-identical on
 * every template). Hand-authored Twig, not a block region. Copy, offices
 * and social links are static for now; the newsletter inputs stay the
 * visual spec of a future webform/newsletter block (see the comment in the
 * markup). The films inside the mark are theme assets (assets/banner/).
 *
 * Behaviour: Drupal.behaviors.iconFooter (icon/site-footer) — replaying
 * reveal, one-video-at-a-time films, scroll-velocity skew.
 */
#}
{% set theme_path = base_path ~ directory %}
<footer class="site-footer">
  <h2 class="site-footer__cta">
    <a class="site-footer__cta-link" href="/contact">
      <!-- Split per word only so each can rise out of its own mask; the
           space between the spans is real, so the link still reads
           "Let's talk Get in touch". -->
      <span class="site-footer__talk"
        ><span class="site-footer__talk-line"><span class="site-footer__talk-word" style="--w: 0">Let&rsquo;s</span></span>
        <span class="site-footer__talk-line"><span class="site-footer__talk-word" style="--w: 1">talk</span></span
      ></span>
      <span class="site-footer__touch invite-arrow">Get in touch</span>
    </a>
  </h2>

  <div class="site-footer__body">
    <div class="site-footer__newsletter">
      <p class="site-footer__blurb">Join our newsletter for industry insights, news and our latest work</p>
      <!-- No <form> yet, on purpose: the subscribe behaviour ships with
           the newsletter slice, and a form here would let Enter fire a
           phantom submit. Drupal: webform/newsletter block renders the
           real form; these two stay its visual spec. -->
      <label class="sr-only" for="footer-email">Email address</label>
      <input class="site-footer__email" id="footer-email" type="email" name="email" placeholder="Your email" autocomplete="email" />
      <button class="site-footer__subscribe invite-arrow" type="button" data-subscribe>Subscribe</button>
    </div>

    <div class="site-footer__locations">
      <h3 class="sr-only">Our offices</h3>
      <ul class="site-footer__offices" role="list">
        <li class="site-footer__office-item" data-rule="top">
          <details class="site-footer__office">
            <summary class="site-footer__office-summary">
              <!-- footer-melbourne-icon.tsx, inlined; fill follows currentColor -->
              <svg class="site-footer__office-icon" viewBox="0 0 278 278" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M243.62,97.25l-7.01-60.45h-15.78l-3.63-22.98L60.7.06l-4.26,36.74h-15.06l-7.01,60.45h14.37l25.68,180.69h129.15l25.68-180.69h14.37ZM52.08,48.8h15.06l4.15-35.77,135.53,11.92,3.76,23.85h15.35l4.23,36.45H47.85l4.23-36.45ZM193.16,265.94h-108.32l-23.98-168.69h156.27l-23.98,168.69Z" /></svg>
              <span class="site-footer__office-city">Melbourne</span>
              <span class="site-footer__office-place">Naarm</span>
              <span class="site-footer__office-toggle" aria-hidden="true"></span>
            </summary>
            <address class="site-footer__office-details">
              <p>Suite 1, Level 2<br />132 Gwynne Street<br />Cremorne VIC 3121 Australia</p>
              <p class="site-footer__office-contact">Phone <a href="tel:+61396424107">03 9642 4107</a><br /><a href="mailto:melbourne@iconagency.com.au">melbourne@iconagency.com.au</a></p>
            </address>
          </details>
        </li>
        <li class="site-footer__office-item" data-rule="top">
          <details class="site-footer__office">
            <summary class="site-footer__office-summary">
              <!-- footer-sydney-icon.tsx, inlined; fill follows currentColor -->
              <svg class="site-footer__office-icon" viewBox="0 0 278 278" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M230.52,104.99h-19.73v-53.65h-65.79V0h-12v51.34h-65.79v53.65h-19.73l14.24,100.92h31.04v72.1h92.47v-72.1h31.05l14.24-100.92ZM79.21,63.34h119.59v41.65h-119.59v-41.65ZM216.71,116.99l-4.58,32.44H65.87l-4.58-32.44h155.41ZM173.23,266h-68.47v-60.1h68.47v60.1ZM72.15,193.9l-4.58-32.47h142.87l-4.58,32.47H72.15Z" /></svg>
              <span class="site-footer__office-city">Sydney</span>
              <span class="site-footer__office-place">Gadigal</span>
              <span class="site-footer__office-toggle" aria-hidden="true"></span>
            </summary>
            <address class="site-footer__office-details">
              <p>Suite 5, Level 6<br />2&ndash;12 Foveaux Street<br />Surry Hills NSW 2010 Australia</p>
              <p class="site-footer__office-contact">Phone <a href="tel:+61261852860">02 6185 2860</a><br /><a href="mailto:sydney@iconagency.com.au">sydney@iconagency.com.au</a></p>
            </address>
          </details>
        </li>
        <li class="site-footer__office-item" data-rule="top">
          <details class="site-footer__office">
            <summary class="site-footer__office-summary">
