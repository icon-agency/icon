{#
/**
 * @file
 * The article Share block — copy link + email (templates/news-article.html,
 * work-article-master.html). Drupal.behaviors.iconShare wires every instance.
 */
#}
<div class="news-article__share" data-share>
  <span class="news-article__share-label" aria-hidden="true">{{ 'Share'|t }}</span>
  <button class="news-article__share-btn" type="button" data-share-copy aria-label="{{ 'Copy link'|t }}">
    <svg class="news-article__share-glyph news-article__share-glyph--link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>
    <svg class="news-article__share-glyph news-article__share-glyph--check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
  </button>
  <a class="news-article__share-btn" href="mailto:" data-share-email aria-label="{{ 'Share by email'|t }}">
    <svg class="news-article__share-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
  </a>
  <span class="sr-only" aria-live="polite" data-share-status></span>
</div>
