/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * News: core's "Promoted to front page" and "Sticky at top of lists" ARE the
 * homepage feed's two controls (the news View's latest display filters on
 * promote and sorts sticky first, then date) — they just need to say so.
 */
function icon_site_form_node_form_alter(array &$form, FormStateInterface $form_state): void {
  // In the Canvas editor's Page data panel the form dresses itself
  // (css/page-data.css): a library attached to the editor page does not
  // reach it, one the form carries does (work-tiles.css found that out).
  if (\Drupal::routeMatch()->getRouteName() === 'canvas.api.form.content_entity') {
    $form['#attached']['library'][] = 'icon_site/page_data';
  }
  _icon_site_work_tile_group($form, $form_state);
  _icon_site_work_legacy_group($form, $form_state);
  _icon_site_work_canvas_link($form, $form_state);
  _icon_site_panel_node_form_alter($form, $form_state);
  $node = $form_state->getFormObject()->getEntity();
  if ($node->bundle() !== 'news') {
    return;
  }
  if (isset($form['promote']['widget']['value'])) {
    $form['promote']['widget']['value']['#title'] = t('Promote to homepage');
    $form['promote']['widget']['value']['#description'] = t('Show this story in the homepage news feed. The feed shows the three newest promoted stories by date.');
  }
  if (isset($form['sticky']['widget']['value'])) {
    $form['sticky']['widget']['value']['#title'] = t('Pin on homepage');
    $form['sticky']['widget']['value']['#description'] = t('Keep this story at the top of the homepage feed whatever its date. It must also be promoted.');
  }
}

/**
 * The Work form's way into Canvas, where the body is built (Sep 2026).
 *
 * The body field has no widget — a component tree is authored in the
 * editor, not on a form — so the form says where it went: a link to
 * /node/{nid}/canvas (icon_site.node_canvas), sitting where the Body was.
 * A new article is saved first; the editor needs an id.
 */
function _icon_site_work_canvas_link(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node instanceof NodeInterface || $node->bundle() !== 'work' || !$node->hasField('field_work_canvas')) {
    return;
  }
  // Where the Body sat: after the colours, before the moderation state
  // (user catch, Sep 2026: "where is Canvas and all the content?" — it
  // stood by the Feature statement, above the fold and easy to pass).
  // The colour pair stands at the top, under the Feature statement (user
  // call, Sep 2026: "colour at the top") — the page's identity, read
  // before its tiles and facts. Set in a #process callback: the form
  // display's own (EntityFormDisplay::processForm()) runs after every
  // alter and writes the display's weights back over the fields.
  $form['#process'][] = '_icon_site_work_colour_weights';
  // Inside the Canvas editor's own panel the body is right there: no link
  // to itself (user catch, Sep 2026).
  if (\Drupal::routeMatch()->getRouteName() === 'canvas.api.form.content_entity') {
    return;
  }
  $form['work_canvas'] = [
    '#type' => 'item',
    '#title' => t('Body'),
    '#weight' => ($form['field_work_deliverables']['#weight'] ?? 50) + 0.5,
    '#description' => t('The body — runs of text with the Share rail, galleries, films, results — is built in Canvas, not on this form. Save the fields above first; the editor keeps its own draft.'),
  ];
  $form['work_canvas']['link'] = $node->isNew()
    ? ['#markup' => t('Save the article first, then build its body in Canvas.')]
    : [
      '#type' => 'link',
      '#title' => t('Build in Canvas'),
      '#url' => Url::fromRoute('icon_site.node_canvas', ['node' => $node->id()]),
      '#attributes' => ['class' => ['button', 'button--primary']],
    ];
}

/**
 * Process callback: the Work form's colour pair right under the statement.
 */
function _icon_site_work_colour_weights(array $element, FormStateInterface $form_state, array &$complete_form): array {
  $statement = $element['field_work_statement']['#weight'] ?? 2;
  if (isset($element['field_work_bg'], $element['field_work_ink'])) {
    $element['field_work_bg']['#weight'] = $statement + 0.1;
    $element['field_work_ink']['#weight'] = $statement + 0.2;
  }
  return $element;
}

/**
 * Implements hook_menu_local_tasks_alter().
 *
 * On a Work node Canvas is THE editor (user call, Sep 2026): the Edit
 * tab — and so the Navigation bar's Edit button, which reads the same
 * tabs — opens the Canvas editor, whose Page data panel carries every
 * field; the classic form stays a tab behind it, "Fields".
 */
function icon_site_menu_local_tasks_alter(array &$data, string $route_name, RefinableCacheableDependencyInterface $cacheability): void {
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof NodeInterface || $node->bundle() !== 'work' || !$node->hasField('field_work_canvas')) {
    return;
  }
  $cacheability->addCacheableDependency($node);
  $tabs = &$data['tabs'][0];
  if (isset($tabs['entity.node.edit_form'], $tabs['icon_site.node_canvas'])) {
    $tabs['entity.node.edit_form']['#link']['url'] = Url::fromRoute('icon_site.node_canvas', ['node' => $node->id()]);
    $tabs['icon_site.node_canvas']['#link']['title'] = t('Fields');
    $tabs['icon_site.node_canvas']['#link']['url'] = $node->toUrl('edit-form');
    $tabs['icon_site.node_canvas']['#weight'] = ($tabs['entity.node.edit_form']['#weight'] ?? 10) + 0.5;
  }
}

/**
 * Implements hook_entity_operation_alter().
 *
 * The content list's Edit on a Work item opens Canvas too; Fields is the
 * classic form.
 */
function icon_site_entity_operation_alter(array &$operations, EntityInterface $entity, CacheableMetadata $cacheability): void {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'work' || !$entity->hasField('field_work_canvas') || !isset($operations['edit'])) {
    return;
  }
  $cacheability->addCacheableDependency($entity);
  $operations['fields'] = $operations['edit'] + ['weight' => ($operations['edit']['weight'] ?? 10) + 1];
  $operations['fields']['title'] = t('Fields');
  $operations['edit']['url'] = Url::fromRoute('icon_site.node_canvas', ['node' => $entity->id()]);
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 *
 * After logging in, land on the homepage rather than the account page. A
 * ?destination= on the login URL still wins (Drupal applies it after the
 * form's own redirect).
 */
function icon_site_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#submit'][] = '_icon_site_login_to_front';
}

/**
 * Submit handler: redirect the login form to the front page.
 */
function _icon_site_login_to_front(array &$form, FormStateInterface $form_state): void {
  $form_state->setRedirect('<front>');
}

/**
 * A file or image-style URL, root-relative.
 *
 * ImageStyle::buildUrl() returns an ABSOLUTE url, and these props are
 * render-cached — so a cached page baked in whatever scheme and host built
 * it (locally, the DDEV port of the day; behind a CDN or a second domain,
 * the wrong origin entirely). Core's own ImageFormatter runs every style URL
 * through transformRelative() for exactly this reason (found in review,
 * Sep 2026). Takes either a stream URI or a built URL.
 */
function icon_site_file_url(string $uri_or_url): string {
  $generator = \Drupal::service('file_url_generator');
  return $generator->transformRelative(preg_match('#^https?://#i', $uri_or_url)
    ? $uri_or_url
    : $generator->generateAbsoluteString($uri_or_url));
}

/**
 * A media item (image OR video) as {type, src, alt, width, height}.
 *
 * Images go through the image style; videos are the file itself. Empty
 * array when there is nothing usable. Shared by the theme (its
 * _icon_media_source() delegates here) and the icon_site blocks.
 */
function icon_site_media_source(?MediaInterface $media, string $style_id, ?CacheableMetadata $cache = NULL): array {
  // The media's view access decides (unpublished, or not for this user →
  // nothing); a public file URL is not permission to show the item. What
  // that decision and the file depend on goes into the caller's $cache —
  // the media, its access result (its contexts), the file, the image style.
  if (!$media instanceof MediaInterface) {
    return [];
  }
  $access = $media->access('view', NULL, TRUE);
  $cache?->addCacheableDependency($media)->addCacheableDependency($access);
  if (!$access->isAllowed()) {
    return [];
  }
  if ($media->bundle() === 'video' && $media->hasField('field_media_video_file') && !$media->get('field_media_video_file')->isEmpty()) {
    $file = $media->get('field_media_video_file')->entity;
    if ($file) {
      $cache?->addCacheableDependency($file);
    }
    if (!$file) {
      return [];
    }
    $source = [
      'type' => 'video',
      'src' => icon_site_file_url($file->getFileUri()),
      // NOT the media label: that is the file name an editor uploaded, and
      // it went straight into the film's aria-label, so screen readers read
      // out "nike-banner.mp4" (found in review, Sep 2026). These loops are
      // decorative — the card's own link, or the article's heading, names
      // the thing — so they get no name at all and the templates hide them.
      'alt' => '',
    ];
    // The optional poster: the still the site shows before the film plays,
    // at the caller's style so it matches the frame it fills.
    if ($media->hasField('field_media_poster') && !$media->get('field_media_poster')->isEmpty()) {
      $poster = $media->get('field_media_poster')->entity;
      $style = ImageStyle::load($style_id);
      if ($poster) {
        $cache?->addCacheableDependency($poster);
        if ($style) {
          $cache?->addCacheableDependency($style);
        }
        $source['poster'] = icon_site_file_url($style ? $style->buildUrl($poster->getFileUri()) : $poster->getFileUri());
      }
    }
    return $source;
  }
  if (!$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
    return [];
  }
  $item = $media->get('field_media_image')->first();
  $file = $item->entity;
  if (!$file) {
    return [];
  }
  $style = ImageStyle::load($style_id);
  $uri = $file->getFileUri();
  $dimensions = ['width' => (int) $item->width, 'height' => (int) $item->height];
  if ($style) {
    $style->transformDimensions($dimensions, $uri);
    $cache?->addCacheableDependency($style);
  }
  $cache?->addCacheableDependency($file);
  return [
    'type' => 'image',
    'src' => icon_site_file_url($style ? $style->buildUrl($uri) : $uri),
    'alt' => (string) $item->alt,
    'width' => $dimensions['width'] ?: NULL,
    'height' => $dimensions['height'] ?: NULL,
  ];
}

/**
 * The hero reel the LOGIN page plays.
 *
 * The hero block on the page named in icon_site.footer `login_hero`
 * (Content → Footer → Login page), else the front page. Its `order` is that
 * block's explicit slide selection.
 *
 * @return array{order: int[], tags: string[]}
 *   The chosen slide node IDs in order (empty when no hero block is on the
 *   page) and the cache tags of where it was read from.
 */
function icon_site_hero_order(): array {
  $tags = ['config:icon_site.footer', 'config:system.site', 'canvas_page_list'];
  $storage = \Drupal::entityTypeManager()->getStorage('canvas_page');
  $page = NULL;
  if ($id = (int) \Drupal::config('icon_site.footer')->get('login_hero')) {
    $page = $storage->load($id);
  }
  if (!$page) {
    $front = (string) \Drupal::config('system.site')->get('page.front');
    $url = $front ? \Drupal::service('path.validator')->getUrlIfValid($front) : NULL;
    if ($url && $url->isRouted() && !empty($url->getRouteParameters()['canvas_page'])) {
      $page = $storage->load($url->getRouteParameters()['canvas_page']);
    }
  }
  if (!$page) {
    return ['order' => [], 'tags' => $tags];
  }
  $tags = Cache::mergeTags($tags, $page->getCacheTags());
  return ['order' => icon_site_hero_order_of($page), 'tags' => $tags];
}

/**
 * A Canvas page's hero block selection.
 *
 * The `order` input of the first block.icon_hero component in its
 * (published) tree, else nothing.
 *
 * @return int[]
 *   The chosen slide node IDs, in order.
 */
function icon_site_hero_order_of(EntityInterface $page): array {
  if (!$page->hasField('components')) {
    return [];
  }
  foreach ($page->get('components') as $item) {
    $value = $item->getValue();
    if (($value['component_id'] ?? '') === 'block.icon_hero') {
      $inputs = $value['inputs'] ?? [];
      $inputs = is_string($inputs) ? (json_decode($inputs, TRUE) ?: []) : $inputs;
      return array_values(array_filter(array_map('intval', (array) ($inputs['order'] ?? []))));
    }
  }
  return [];
}

/**
 * The hero's slides: the CHOSEN ones, in order.
 *
 * A hero shows only the slides its block selected — Content → the panel's
 * reel; a published slide not in the selection is "available", not shown.
 * Pass NULL for the login page's hero (icon_site_hero_order()). Unpublished
 * or inaccessible slides drop out.
 *
 * @return \Drupal\node\NodeInterface[]
 *   Keyed by node ID, in the given order.
 */
function icon_site_hero_slides(?array $order = NULL): array {
  $order = array_values(array_filter(array_map('intval', $order ?? icon_site_hero_order()['order'])));
  if (!$order) {
    return [];
  }
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $slides = [];
  foreach ($storage->loadMultiple($order) as $id => $slide) {
    if ($slide->bundle() === 'hero_slide' && $slide->isPublished() && $slide->access('view')) {
      $slides[(int) $id] = $slide;
    }
  }
  // loadMultiple keys by id but not in the asked order.
  return array_replace(array_flip(array_filter($order, fn($id) => isset($slides[$id]))), $slides);
}

/**
 * Every published Hero slide NOT in the given selection, oldest first.
 *
 * What the hero panel offers to add to its reel.
 *
 * @return \Drupal\node\NodeInterface[]
 *   The slide nodes, keyed by node ID.
 */
function icon_site_hero_available(array $order): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $query = $storage->getQuery()->accessCheck(TRUE)->condition('type', 'hero_slide')->condition('status', 1)->sort('created', 'ASC');
  if ($order = array_values(array_filter(array_map('intval', $order)))) {
    $query->condition('nid', $order, 'NOT IN');
  }
  return $storage->loadMultiple($query->execute());
}

/**
 * The hero reel as data.
 *
 * One row per slide that has media, in order, capped at the hero's maximum.
 * The Homepage hero block renders these as Hero slide components; the login
 * page's banner plays the same rows as its film.
 *
 * @return array{slides: array<int, array{client: string, url: string, source: array}>, tags: string[], cache: \Drupal\Core\Cache\CacheableMetadata}
 *   Each slide's client name, link (may be empty) and media source
 *   (icon_site_media_source(): type video|image, src, alt, width, height),
 *   the cache tags of everything read, and the full cacheability (tags,
 *   contexts, max-age — the slides' and media's access results included)
 *   for the caller to apply to what it renders.
 */
function icon_site_hero_reel(?array $order = NULL, string $style_id = 'work_media'): array {
  $cache = (new CacheableMetadata())->addCacheTags(['node_list:hero_slide']);
  if ($order === NULL) {
    $read = icon_site_hero_order();
    $order = $read['order'];
    $cache->addCacheTags($read['tags']);
  }
  $slides = [];
  foreach (array_slice(icon_site_hero_slides($order), 0, HeroBlock::MAX, TRUE) as $slide) {
    $cache->addCacheableDependency($slide)->addCacheableDependency($slide->access('view', NULL, TRUE));
    $media = $slide->get('field_slide_media')->entity;
    $source = icon_site_media_source($media, $style_id, $cache);
    if (!$source) {
      continue;
    }
    $link = $slide->get('field_slide_link')->first();
    $slides[] = [
      'client' => (string) $slide->label(),
      'url' => $link ? $link->getUrl()->toString() : '',
      'source' => $source,
    ];
  }
  return ['slides' => $slides, 'tags' => $cache->getCacheTags(), 'cache' => $cache];
}

/**
 * The global footer's words.
 *
 * The icon_site.footer config (Content → Footer), with the design system's
 * copy as the fallback, plus the social links from the footer-social menu,
 * in menu order.
 *
 * @return array{talk: string, touch: string, touch_url: string, newsletter: string, acknowledgement: string, social: array<int, array{title: string, url: string}>, tags: string[]}
 *   The words, the social links (title and URL each) and the cache tags of
 *   everything read.
 */
function icon_site_footer(): array {
  $config = \Drupal::config('icon_site.footer');
  $out = [
    'talk' => (string) ($config->get('talk') ?: "Let’s talk"),
    'touch' => (string) ($config->get('touch') ?: 'Get in touch'),
    'touch_url' => (string) ($config->get('touch_url') ?: '/contact'),
    'newsletter' => (string) ($config->get('newsletter') ?? 'Join our newsletter for industry insights, news and our latest work'),
    'acknowledgement' => (string) ($config->get('acknowledgement') ?? 'ICON recognises the First Peoples of this nation and their ongoing connection to culture and country. We acknowledge First Nations Peoples as the Traditional Owners, Custodians and Lore Keepers of the world’s oldest living culture and pay respects to their Elders past, present and emerging.'),
    'social' => [],
    'tags' => ['config:icon_site.footer', 'config:system.menu.footer-social'],
  ];
  $tree = \Drupal::menuTree();
  $params = (new MenuTreeParameters())->setMaxDepth(1)->onlyEnabledLinks();
  $links = $tree->transform($tree->load('footer-social', $params), [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);
  foreach ($links as $element) {
    if ($element->access && !$element->access->isAllowed()) {
      continue;
    }
    $out['social'][] = [
      'title' => (string) $element->link->getTitle(),
      'url' => $element->link->getUrlObject()->toString(),
    ];
  }
  return $out;
}

/**
 * The global footer's offices.
 *
 * Published Office content in list order (Content → Offices), as the footer
 * template reads them.
 *
 * @return array{offices: array<int, array{city: string, place: string, lines: string[], phone: string, phone_href: string, email: string, icon: int|null}>, tags: string[]}
 *   One row per office (city, place, address lines, phone and its tel: href,
 *   email, icon media ID) and the cache tags of everything read.
 */
function icon_site_offices(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'office')
    ->condition('status', 1)
    ->sort('field_office_weight', 'ASC')
    ->sort('title', 'ASC')
    ->execute();
  $out = ['offices' => [], 'tags' => ['node_list:office']];
  foreach ($storage->loadMultiple($ids) as $office) {
    $phone = trim((string) $office->get('field_office_phone')->value);
    $digits = preg_replace('/\D+/', '', $phone);
    $out['offices'][] = [
      'city' => (string) $office->label(),
      'place' => (string) $office->get('field_office_place')->value,
      'lines' => array_values(array_filter(array_map('trim', preg_split('/\r\n|\r|\n/', (string) $office->get('field_office_address')->value)))),
      'phone' => $phone,
      'phone_href' => $digits ? 'tel:' . (str_starts_with($digits, '0') ? '+61' . substr($digits, 1) : (str_starts_with($digits, '61') ? '+' . $digits : $digits)) : '',
      'email' => (string) $office->get('field_office_email')->value,
      'icon' => $office->get('field_office_icon')->target_id ? (int) $office->get('field_office_icon')->target_id : NULL,
    ];
    $out['tags'] = Cache::mergeTags($out['tags'], $office->getCacheTags());
  }
  return $out;
}

/**
 * Implements hook_preprocess_HOOK() for media.html.twig.
 *
 * An Icon in the media library's grid shows the SVG itself (its thumbnail
 * would be the generic file icon): inlined in the text colour on white.
 */
function icon_site_preprocess_media(array &$variables): void {
  $media = $variables['media'] ?? NULL;
  if (!$media instanceof MediaInterface || $media->bundle() !== 'icon' || ($variables['view_mode'] ?? '') !== 'media_library') {
    return;
  }
  $svg = (new IconSiteExtension(\Drupal::entityTypeManager(), \Drupal::service('stream_wrapper_manager')))->inlineSvg((string) $media->id(), '');
  $variables['content']['icon_svg'] = [
    '#markup' => Markup::create('<div style="aspect-ratio:1;display:grid;place-items:center;padding:14%;box-sizing:border-box;color:#222;background:#fff">' . $svg . '</div>'),
    '#weight' => -10,
  ];
}

/**
 * The Work form's tile, as one block.
 *
 * The four tile fields — the square tile, the wide one, the foreground that
 * floats over either and its inset — are one OPEN details, two up (the
 * grid is css/work-tiles.css), so the card's whole picture is read in one
 * place; the legacy folio card follows it, closed. Called from
 * icon_site_form_node_form_alter().
 */
function _icon_site_work_tile_group(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  $fields = ['field_work_tile', 'field_work_tile_wide', 'field_work_tile_fg', 'field_work_tile_inset'];
  if ($node->bundle() !== 'work' || array_diff($fields, array_keys($form))) {
    return;
  }
  $form['tile'] = [
    '#type' => 'details',
    '#title' => t('Tile'),
    '#description' => t('The card on /work and the homepage. The square tile is the one every card has; the wide one is for the landscape frames; the foreground is optional — a logo or a cut-out that floats over either.'),
    '#open' => TRUE,
    '#weight' => $form['field_work_tile']['#weight'] ?? 0,
    '#attributes' => ['class' => ['icon-work-tiles']],
    '#attached' => ['library' => ['icon_site/work_tiles']],
  ];
  foreach ($fields as $name) {
    $form[$name]['#group'] = 'tile';
  }
}

/**
 * The Work form's legacy folio card.
 *
 * The Layers field sits closed in its own details, out of the way of the new
 * tile, for the projects brought over from the old site. Called from
 * icon_site_form_node_form_alter().
 */
function _icon_site_work_legacy_group(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if ($node->bundle() !== 'work' || !isset($form['field_work_legacy_layers'])) {
    return;
  }
  $form['legacy'] = [
    '#type' => 'details',
    '#title' => t('Legacy folio card (old site)'),
    '#description' => t('For a project brought over from iconagency.com.au: its tile there was a stack of square cut-out images that tilts to the cursor, each layer lifting a step further on hover. Add the layers here, back to front (one to six square PNGs), and the card uses that instead of the Tile above. Leave empty for the new tile.'),
    '#open' => !$node->get('field_work_legacy_layers')->isEmpty(),
    '#weight' => ($form['field_work_tile']['#weight'] ?? 0) + 0.5,
  ];
  $form['field_work_legacy_layers']['#group'] = 'legacy';
}

/**
 * Implements hook_canvas_storable_prop_shape_alter().
 *
 * An icon prop — `type: integer` with `x-icon-media: true` — is stored as a
 * reference to an Icon media item and edited as a SELECT of the Fact icons
 * list (Content → Fact icons), so the dropdown is content-managed. The prop
 * evaluates to the media ID, which the component hands to icon_inline_svg()
 * to inline the file. Why an ID rather than the file URI: Canvas's widgets
 * display the prop's RESOLVED value — a select preselects the option whose
 * key equals it — so the resolved value must be what the widget shows. And
 * Canvas has no SVG media shape of its own: the Image shape only matches
 * Image-source media types, and Drupal's image field refuses SVG, hence the
 * File-source `icon` type and this mapping.
 */
function icon_site_canvas_storable_prop_shape_alter(CandidateStorablePropShape $storable_prop_shape): void {
  $schema = $storable_prop_shape->shape->schema;
  if (($schema['type'] ?? NULL) !== 'integer' || empty($schema['x-icon-media'])) {
    return;
  }
  $storable_prop_shape->fieldTypeProp = new FieldTypePropExpression('entity_reference', 'target_id');
  $storable_prop_shape->fieldStorageSettings = ['target_type' => 'media'];
  $storable_prop_shape->fieldInstanceSettings = [
    'handler' => 'default:media',
    'handler_settings' => [
      'target_bundles' => ['icon' => 'icon'],
      'sort' => ['field' => 'field_logo_weight.value', 'direction' => 'ASC'],
      'auto_create' => FALSE,
    ],
  ];
  $storable_prop_shape->fieldWidget = 'options_select';
}

/**
 * Implements hook_page_attachments().
 *
 * The Canvas editor is one React page; the side panel's forms are rendered
 * inside it, and a library attached by a block form's render array does not
 * reach it. So the panel lists' stylesheet rides on the editor page itself.
 */
function icon_site_page_attachments(array &$attachments): void {
  if (str_starts_with((string) \Drupal::routeMatch()->getRouteName(), 'canvas.')) {
    // Canvas 1.11's editor builds its own HtmlResponse, past this hook;
    // the panels' forms carry the library themselves (blockForm(),
    // icon_site_form_node_form_alter()). Kept for the other canvas.* pages.
    $attachments['#attached']['library'][] = 'icon_site/panel_lists';
  }
}

/**
 * Fits a Hero slide or Team member form from a Canvas panel to a dialog.
 *
 * The form arrives with ?panel=1.
 *
 * The form lives in a dialog over the editor: Save submits by ajax and
 * closes the dialog (or re-renders the form with its errors); Preview and
 * Delete, which would navigate away, are dropped.
 */
function _icon_site_panel_node_form_alter(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if (!in_array($node->bundle(), ['hero_slide', 'team_member'], TRUE) || !\Drupal::request()->query->get('panel')) {
    return;
  }
  $form['#prefix'] = '<div id="icon-panel-form">';
  $form['#suffix'] = '</div>';
  // An existing slide's dialog carries the reel action — "Remove from reel"
  // or "Add to reel", which one the panel script decides from where the
  // slide's row sits when the dialog opens. The reel is the block's setting
  // (Canvas autosaves it), so the move is made client-side, not saved here.
  if ($node->bundle() === 'hero_slide' && !$node->isNew()) {
    $form['actions']['reel'] = [
      '#markup' => '<a href="#" role="button" class="button button--danger icon-panel__remove icon-panel__dialog-reel" data-nid="' . (int) $node->id() . '">' . t('Remove from reel') . '</a>',
      '#weight' => 10,
    ];
  }
  // Remember whether this save CREATES the item (read after the save)
  array_unshift($form['actions']['submit']['#submit'], '_icon_site_panel_note_new');
  $form['actions']['submit']['#ajax'] = [
    'callback' => '_icon_site_panel_form_ajax',
    'wrapper' => 'icon-panel-form',
  ];
  $form['actions']['preview']['#access'] = FALSE;
  $form['actions']['delete']['#access'] = FALSE;
  // Other modules (menu_ui, path) add their sections AFTER this alter runs,
  // so the trimming happens at after-build, when the form is complete.
  $form['#after_build'][] = '_icon_site_panel_node_form_after_build';
}

/**
 * Trims the dialog'd slide form to its fields: no meta, menu, path, revision.
 */
function _icon_site_panel_node_form_after_build(array $form, FormStateInterface $form_state): array {
  // NOT `status`: a widget hidden with #access has no submitted value, and the
  // save unpublished the slide. Published stays — it is how a slide leaves
  // the reel without being deleted.
  // (`footer` is where the node form keeps that checkbox — leave it too.)
  // (`field_logo_weight`, `field_team_weight`: the panels' drags write
  // the order.)
  $hidden = [
    'menu',
    'meta',
    'revision_information',
    'revision_log',
    'uid',
    'created',
    'promote',
    'sticky',
    'path',
    'advanced',
    'field_logo_weight',
    'field_team_weight',
  ];
  foreach ($hidden as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }
  return $form;
}

/**
 * Submit handler: notes whether this save creates the entity.
 */
function _icon_site_panel_note_new(array &$form, FormStateInterface $form_state): void {
  $form_state->set('icon_panel_was_new', $form_state->getFormObject()->getEntity()->isNew());
}

/**
 * Save from the dialog: close it, or show the form again with its errors.
 */
function _icon_site_panel_form_ajax(array $form, FormStateInterface $form_state): AjaxResponse {
  $response = new AjaxResponse();
  if ($form_state->hasAnyErrors()) {
    // The dialog has no message region: put the errors at the top of the
    // form itself, or a failed save looks like nothing happened.
    $form['panel_messages'] = ['#type' => 'status_messages', '#weight' => -100];
    $response->addCommand(new ReplaceCommand('#icon-panel-form', $form));
    return $response;
  }
  $response->addCommand(new CloseDialogCommand('#icon-panel-dialog'));
  // Tell the panel's sortable script what was saved — the entity's id and
  // whether it was created just now (a new Hero slide goes straight into
  // the reel) — so it can write the change and nudge Canvas to re-fetch
  // the block form.
  $entity = $form_state->getFormObject()->getEntity();
  $response->addCommand(new InvokeCommand('body', 'trigger', [
    'icon-panel:saved',
    [
      [
        (int) $entity->id(),
        (bool) $form_state->get('icon_panel_was_new'),
      ],
    ],
  ]));
  return $response;
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for media_form.
 *
 * A Logo / Icon / Image media form opened from a Canvas panel (?panel=1)
 * gets the same dialog treatment as a Hero slide: ajax Save that closes the
 * dialog, no Preview / Delete, and the housekeeping sections trimmed. An
 * Image is the filmstrip panel's photo.
 */
function icon_site_form_media_form_alter(array &$form, FormStateInterface $form_state): void {
  $media = $form_state->getFormObject()->getEntity();
  $request = \Drupal::request();
  if (!in_array($media->bundle(), ['logo', 'icon', 'image'], TRUE) || !$request->query->get('panel')) {
    return;
  }
  $form['#prefix'] = '<div id="icon-panel-form">';
  $form['#suffix'] = '</div>';
  // Remember whether this save CREATES the item (read after the save)
  array_unshift($form['actions']['submit']['#submit'], '_icon_site_panel_note_new');
  $form['actions']['submit']['#ajax'] = [
    'callback' => '_icon_site_panel_form_ajax',
    'wrapper' => 'icon-panel-form',
  ];
  $form['actions']['delete']['#access'] = FALSE;
  // A photo added from the filmstrip panel: its Type is the panel's
  // (?category=intro), and it has no marquee to be removed from.
  if ($media->bundle() === 'image') {
    $type = (string) $request->query->get('category', '');
    if ($type !== '' && isset($form['field_media_category']['widget']) && $media->isNew()) {
      $form['field_media_category']['widget']['#default_value'] = [$type];
    }
    $form['#after_build'][] = '_icon_site_panel_node_form_after_build';
    return;
  }
  // Removing from the marquee lives HERE, behind Edit, not as a one-click
  // link in the list: it unpublishes (the file stays in the library).
  if (isset($form['status']['widget']['value'])) {
    $form['status']['widget']['value']['#title'] = t('Shown on the site');
    $form['status']['widget']['value']['#description'] = t('Untick to take it out of the marquee without deleting it.');
  }
  $form['actions']['remove'] = [
    '#type' => 'submit',
    '#value' => t('Remove from marquee'),
    '#weight' => 10,
    '#attributes' => ['class' => ['button', 'button--danger', 'icon-panel__remove']],
    '#submit' => ['_icon_site_panel_remove_submit', '::submitForm', '::save'],
    '#ajax' => [
      'callback' => '_icon_site_panel_form_ajax',
      'wrapper' => 'icon-panel-form',
    ],
  ];
  $form['#after_build'][] = '_icon_site_panel_node_form_after_build';
}

/**
 * Submit handler for "Remove from marquee": unpublish, then the normal save.
 */
function _icon_site_panel_remove_submit(array &$form, FormStateInterface $form_state): void {
  $form_state->setValue(['status', 'value'], 0);
}

/**
 * Implements hook_module_implements_alter().
 *
 * Our image-widget alter runs after ai_image_alt_text's, so it can take the
 * AI button off a widget that one has just added; our page_top runs after
 * environment_indicator's, so it can take that module's bar back out (core
 * has no page_top alter hook).
 */
function icon_site_module_implements_alter(array &$implementations, string $hook): void {
  if (!in_array($hook, ['field_widget_single_element_form_alter', 'page_top'], TRUE) || !isset($implementations['icon_site'])) {
    return;
  }
  $group = $implementations['icon_site'];
  unset($implementations['icon_site']);
  $implementations['icon_site'] = $group;
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 *
 * AI alt-text generation (ai_image_alt_text) sends the image to a vision
 * model, which cannot read an SVG: the button is taken off an SVG upload
 * and the description says why. Lifted from the Drupal AI build's
 * icon_ai_alt_text module (Frank Recalde, Sep 2026).
 */
function icon_site_field_widget_single_element_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  if (!$context['widget'] instanceof ImageWidget || empty($element['ai_alt_text_generation'])) {
    return;
  }
  $fid = $element['#default_value']['fids'][0] ?? NULL;
  if (!$fid) {
    return;
  }
  $file = \Drupal::entityTypeManager()->getStorage('file')->load($fid);
  if (!$file instanceof FileInterface) {
    return;
  }
  $extension = strtolower(pathinfo($file->getFilename(), PATHINFO_EXTENSION));
  if ($file->getMimeType() !== 'image/svg+xml' && $extension !== 'svg') {
    return;
  }
  unset($element['ai_alt_text_generation']);
  $message = t('AI alt text generation is not available for SVG files. Enter alt text by hand, or upload a PNG, JPEG, WebP or AVIF version if you want it generated.');
  $description = trim((string) ($element['#description'] ?? ''));
  $element['#description'] = $description === '' ? $message : $description . '<br>' . $message;
}

/**
 * Implements hook_page_top().
 *
 * Environment Indicator's fallback bar is an in-flow block at the top of the
 * page. With the Navigation module that bar sits under Navigation's fixed top
 * bar (invisible) while still pushing the page down by its height. The bar
 * goes; its attachments (the environment favicon) stay; the environment name
 * moves into the top bar (Plugin\TopBarItem\EnvironmentBadge). Ordered after
 * environment_indicator's hook by icon_site_module_implements_alter().
 */
function icon_site_page_top(array &$page_top): void {
  if (!isset($page_top['indicator']) || !\Drupal::moduleHandler()->moduleExists('navigation')) {
    return;
  }
  $page_top['indicator'] = ['#attached' => $page_top['indicator']['#attached'] ?? []];
}

/**
 * Implements hook_ENTITY_TYPE_presave() for media.
 *
 * A film with a Poster wears it as its thumbnail — the picture the media
 * library and every admin list show — in place of the generic play glyph
 * core gives a video file. Runs after core's own thumbnail update.
 */
function icon_site_media_presave(MediaInterface $media): void {
  if ($media->bundle() !== 'video' || !$media->hasField('field_media_poster') || $media->get('field_media_poster')->isEmpty()) {
    return;
  }
  $poster = $media->get('field_media_poster')->entity;
  if ($poster instanceof FileInterface) {
    $media->set('thumbnail', [
      'target_id' => $poster->id(),
      'alt' => (string) ($media->get('field_media_poster')->alt ?: $media->label()),
    ]);
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for media_library_add_form.
 *
 * Media added from inside a content form is almost always for that content:
 * the folder (field_media_category) on each new item is pre-selected from the
 * bundle the library was opened from — a Work page or any of its work_*
 * blocks, a News story or its news_* blocks, a Hero slide — so an editor on a
 * Work page is not asked where a work image belongs. The field is required,
 * so where nothing can be inferred (a shared block, the library itself) the
 * editor picks one.
 */
function icon_site_form_media_library_add_form_alter(array &$form, FormStateInterface $form_state): void {
  $state = $form_state->get('media_library_state');
  if (!$state instanceof MediaLibraryState) {
    return;
  }
  $type = _icon_site_media_folder_for((string) ($state->getOpenerParameters()['bundle'] ?? ''));
  if (!$type || empty($form['media']) || !is_array($form['media'])) {
    return;
  }
  foreach (Element::children($form['media']) as $delta) {
    $widget = &$form['media'][$delta]['fields']['field_media_category']['widget'] ?? NULL;
    if (is_array($widget) && empty($widget['#default_value'])) {
      $widget['#default_value'] = [$type];
    }
    unset($widget);
  }
}

/**
 * The media folder a content or paragraph bundle belongs to.
 *
 * A Work page and every work_* paragraph (a gallery figure, a scroller, a
 * film) are Work; a News story and its news_* paragraphs are News; a Hero
 * slide is Hero. The shared blocks (prose, pull quote) say nothing, and the
 * editor chooses.
 */
function _icon_site_media_folder_for(string $bundle): ?string {
  if ($bundle === 'hero_slide') {
    return 'hero';
  }
  if ($bundle === 'work' || str_starts_with($bundle, 'work_')) {
    return 'work';
  }
  if ($bundle === 'news' || str_starts_with($bundle, 'news_')) {
    return 'news';
  }
  return NULL;
}

/**
 * Implements hook_field_widget_complete_form_alter().
 *
 * The Work body's Add Block dialog reads in groups (user call, Sep 2026):
 * Content, Pull quote / Gallery, Gallery scroller / Video embed, Video hosted
 * / Results and stats. Paragraphs lists its add buttons in the field's own
 * order (target_bundles_drag_drop); the first button of each group is
 * marked, and css/block-picker.css opens its row with a hairline.
 */
function icon_site_field_widget_complete_form_alter(array &$field_widget_complete_form, FormStateInterface $form_state, array $context): void {
  if ($context['items']->getFieldDefinition()->getName() !== 'field_work_content' || empty($field_widget_complete_form['widget']['add_more'])) {
    return;
  }
  $add_more = &$field_widget_complete_form['widget']['add_more'];
  foreach (['prose', 'work_gallery_row', 'news_article_video', 'work_stats'] as $first) {
    if (isset($add_more['add_more_button_' . $first])) {
      $add_more['add_more_button_' . $first]['#attributes']['class'][] = 'icon-block-group-start';
    }
  }
  $field_widget_complete_form['#attached']['library'][] = 'icon_site/block_picker';
}

/**
 * A team member's slug — the panel's address under /about.
 *
 * Pathauto's cleaner, so "Joanne Painter" is joanne-painter the same way
 * the site's aliases are made. Used by the Team profiles block (the links
 * and the panel), and by TeamProfilePathProcessor to recognise
 * /about/<slug> on the way in.
 */
function icon_site_team_slug(string $name): string {
  return \Drupal::service('pathauto.alias_cleaner')->cleanString($name);
}

/**
 * The published Team members, in order (Order field, then name).
 *
 * @return \Drupal\node\NodeInterface[]
 *   The members the current user may view, in the block's order.
 */
function icon_site_team_members(?CacheableMetadata $cache = NULL): array {
  $cache?->addCacheTags(['node_list:team_member']);
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'team_member')
    ->condition('status', 1)
    ->sort('field_team_weight', 'ASC')
    ->sort('title', 'ASC')
    ->execute();
  $members = [];
  foreach ($storage->loadMultiple($ids) as $node) {
    $access = $node->access('view', NULL, TRUE);
    $cache?->addCacheableDependency($node)->addCacheableDependency($access);
    if ($access->isAllowed()) {
      $members[] = $node;
    }
  }
  return $members;
}

/**
 * The published team members' slugs — what /about/<slug> may be.
 */
function icon_site_team_slugs(): array {
  static $slugs = NULL;
  if ($slugs === NULL) {
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $ids = $storage->getQuery()->accessCheck(FALSE)->condition('type', 'team_member')->condition('status', 1)->execute();
    $slugs = array_map(static fn($n) => icon_site_team_slug($n->label()), $storage->loadMultiple($ids));
  }
  return array_values($slugs);
}
