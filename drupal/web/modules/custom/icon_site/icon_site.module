<?php

/**
 * @file
 * ICON site glue — hooks.
 */

declare(strict_types=1);

use Drupal\canvas\PropExpressions\StructuredData\FieldTypePropExpression;
use Drupal\canvas\PropShape\CandidateStorablePropShape;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\CloseDialogCommand;
use Drupal\Core\Ajax\InvokeCommand;
use Drupal\Core\Ajax\ReplaceCommand;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Form\FormStateInterface;
use Drupal\image\Entity\ImageStyle;
use Drupal\media\MediaInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * News: core's "Promoted to front page" and "Sticky at top of lists" ARE the
 * homepage feed's two controls (the news View's latest display filters on
 * promote and sorts sticky first, then date) — they just need to say so.
 */
function icon_site_form_node_form_alter(array &$form, FormStateInterface $form_state): void {
  _icon_site_work_legacy_group($form, $form_state);
  _icon_site_panel_node_form_alter($form, $form_state);
  $node = $form_state->getFormObject()->getEntity();
  if ($node->bundle() !== 'news') {
    return;
  }
  if (isset($form['promote']['widget']['value'])) {
    $form['promote']['widget']['value']['#title'] = t('Promote to homepage');
    $form['promote']['widget']['value']['#description'] = t('Show this story in the homepage news feed. The feed shows the three newest promoted stories by date.');
  }
  if (isset($form['sticky']['widget']['value'])) {
    $form['sticky']['widget']['value']['#title'] = t('Pin on homepage');
    $form['sticky']['widget']['value']['#description'] = t('Keep this story at the top of the homepage feed whatever its date. It must also be promoted.');
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 *
 * After logging in, land on the homepage rather than the account page. A
 * ?destination= on the login URL still wins (Drupal applies it after the
 * form's own redirect).
 */
function icon_site_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#submit'][] = '_icon_site_login_to_front';
}

/**
 * Submit handler: redirect the login form to the front page.
 */
function _icon_site_login_to_front(array &$form, FormStateInterface $form_state): void {
  $form_state->setRedirect('<front>');
}

/**
 * A media item (image OR video) as {type, src, alt, width, height}.
 *
 * Images go through the image style; videos are the file itself. Empty
 * array when there is nothing usable. Shared by the theme (its
 * _icon_media_source() delegates here) and the icon_site blocks.
 */
function icon_site_media_source(?MediaInterface $media, string $style_id, ?CacheableMetadata $cache = NULL): array {
  // The media's view access decides (unpublished, or not for this user →
  // nothing); a public file URL is not permission to show the item. What
  // that decision and the file depend on goes into the caller's $cache —
  // the media, its access result (its contexts), the file, the image style.
  if (!$media instanceof MediaInterface) {
    return [];
  }
  $access = $media->access('view', NULL, TRUE);
  $cache?->addCacheableDependency($media)->addCacheableDependency($access);
  if (!$access->isAllowed()) {
    return [];
  }
  if ($media->bundle() === 'video' && $media->hasField('field_media_video_file') && !$media->get('field_media_video_file')->isEmpty()) {
    $file = $media->get('field_media_video_file')->entity;
    if ($file) {
      $cache?->addCacheableDependency($file);
    }
    return $file ? [
      'type' => 'video',
      'src' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
      'alt' => $media->label(),
    ] : [];
  }
  if (!$media->hasField('field_media_image') || $media->get('field_media_image')->isEmpty()) {
    return [];
  }
  $item = $media->get('field_media_image')->first();
  $file = $item->entity;
  if (!$file) {
    return [];
  }
  $style = ImageStyle::load($style_id);
  $uri = $file->getFileUri();
  $dimensions = ['width' => (int) $item->width, 'height' => (int) $item->height];
  if ($style) {
    $style->transformDimensions($dimensions, $uri);
    $cache?->addCacheableDependency($style);
  }
  $cache?->addCacheableDependency($file);
  return [
    'type' => 'image',
    'src' => $style ? $style->buildUrl($uri) : \Drupal::service('file_url_generator')->generateString($uri),
    'alt' => (string) $item->alt,
    'width' => $dimensions['width'] ?: NULL,
    'height' => $dimensions['height'] ?: NULL,
  ];
}

/**
 * The hero reel the LOGIN page plays: the hero block on the page named in
 * icon_site.footer `login_hero` (Content → Footer → Login page), else the
 * front page. Its `order` is that block's explicit slide selection.
 *
 * @return array{order: int[], tags: string[]}
 *   The chosen slide node IDs in order (empty when no hero block is on the
 *   page) and the cache tags of where it was read from.
 */
function icon_site_hero_order(): array {
  $tags = ['config:icon_site.footer', 'config:system.site', 'canvas_page_list'];
  $storage = \Drupal::entityTypeManager()->getStorage('canvas_page');
  $page = NULL;
  if ($id = (int) \Drupal::config('icon_site.footer')->get('login_hero')) {
    $page = $storage->load($id);
  }
  if (!$page) {
    $front = (string) \Drupal::config('system.site')->get('page.front');
    $url = $front ? \Drupal::service('path.validator')->getUrlIfValid($front) : NULL;
    if ($url && $url->isRouted() && !empty($url->getRouteParameters()['canvas_page'])) {
      $page = $storage->load($url->getRouteParameters()['canvas_page']);
    }
  }
  if (!$page) {
    return ['order' => [], 'tags' => $tags];
  }
  $tags = Cache::mergeTags($tags, $page->getCacheTags());
  return ['order' => icon_site_hero_order_of($page), 'tags' => $tags];
}

/**
 * A Canvas page's hero block selection: the `order` input of the first
 * block.icon_hero component in its (published) tree, else nothing.
 *
 * @return int[]
 */
function icon_site_hero_order_of(\Drupal\Core\Entity\EntityInterface $page): array {
  if (!$page->hasField('components')) {
    return [];
  }
  foreach ($page->get('components') as $item) {
    $value = $item->getValue();
    if (($value['component_id'] ?? '') === 'block.icon_hero') {
      $inputs = $value['inputs'] ?? [];
      $inputs = is_string($inputs) ? (json_decode($inputs, TRUE) ?: []) : $inputs;
      return array_values(array_filter(array_map('intval', (array) ($inputs['order'] ?? []))));
    }
  }
  return [];
}

/**
 * The hero's slides: the CHOSEN ones, in order (a hero shows only the slides
 * its block selected — Content → the panel's reel; a published slide not in
 * the selection is "available", not shown). Pass NULL for the login page's
 * hero (icon_site_hero_order()). Unpublished or inaccessible slides drop out.
 *
 * @return \Drupal\node\NodeInterface[]
 *   Keyed by node ID, in the given order.
 */
function icon_site_hero_slides(?array $order = NULL): array {
  $order = array_values(array_filter(array_map('intval', $order ?? icon_site_hero_order()['order'])));
  if (!$order) {
    return [];
  }
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $slides = [];
  foreach ($storage->loadMultiple($order) as $id => $slide) {
    if ($slide->bundle() === 'hero_slide' && $slide->isPublished() && $slide->access('view')) {
      $slides[(int) $id] = $slide;
    }
  }
  // loadMultiple keys by id but not in the asked order
  return array_replace(array_flip(array_filter($order, fn($id) => isset($slides[$id]))), $slides);
}

/**
 * Every published Hero slide NOT in the given selection, oldest first: what
 * the hero panel offers to add to its reel.
 *
 * @return \Drupal\node\NodeInterface[]
 */
function icon_site_hero_available(array $order): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $query = $storage->getQuery()->accessCheck(TRUE)->condition('type', 'hero_slide')->condition('status', 1)->sort('created', 'ASC');
  if ($order = array_values(array_filter(array_map('intval', $order)))) {
    $query->condition('nid', $order, 'NOT IN');
  }
  return $storage->loadMultiple($query->execute());
}

/**
 * The hero reel as data: one row per slide that has media, in order, capped
 * at the hero's maximum. The Homepage hero block renders these as Hero slide
 * components; the login page's banner plays the same rows as its film.
 *
 * @return array{slides: array<int, array{client: string, url: string, source: array}>, tags: string[], cache: \Drupal\Core\Cache\CacheableMetadata}
 *   Each slide's client name, link (may be empty) and media source
 *   (icon_site_media_source(): type video|image, src, alt, width, height),
 *   the cache tags of everything read, and the full cacheability (tags,
 *   contexts, max-age — the slides' and media's access results included)
 *   for the caller to apply to what it renders.
 */
function icon_site_hero_reel(?array $order = NULL, string $style_id = 'work_media'): array {
  $cache = (new CacheableMetadata())->addCacheTags(['node_list:hero_slide']);
  if ($order === NULL) {
    $read = icon_site_hero_order();
    $order = $read['order'];
    $cache->addCacheTags($read['tags']);
  }
  $slides = [];
  foreach (array_slice(icon_site_hero_slides($order), 0, \Drupal\icon_site\Plugin\Block\HeroBlock::MAX, TRUE) as $slide) {
    $cache->addCacheableDependency($slide)->addCacheableDependency($slide->access('view', NULL, TRUE));
    $media = $slide->get('field_slide_media')->entity;
    $source = icon_site_media_source($media, $style_id, $cache);
    if (!$source) {
      continue;
    }
    $link = $slide->get('field_slide_link')->first();
    $slides[] = [
      'client' => (string) $slide->label(),
      'url' => $link ? $link->getUrl()->toString() : '',
      'source' => $source,
    ];
  }
  return ['slides' => $slides, 'tags' => $cache->getCacheTags(), 'cache' => $cache];
}

/**
 * The global footer's words: icon_site.footer config (Content → Footer), with
 * the design system's copy as the fallback, plus the social links from the
 * footer-social menu, in menu order.
 *
 * @return array{talk: string, touch: string, touch_url: string, newsletter: string, acknowledgement: string, social: array<int, array{title: string, url: string}>, tags: string[]}
 */
function icon_site_footer(): array {
  $config = \Drupal::config('icon_site.footer');
  $out = [
    'talk' => (string) ($config->get('talk') ?: "Let’s talk"),
    'touch' => (string) ($config->get('touch') ?: 'Get in touch'),
    'touch_url' => (string) ($config->get('touch_url') ?: '/contact'),
    'newsletter' => (string) ($config->get('newsletter') ?? 'Join our newsletter for industry insights, news and our latest work'),
    'acknowledgement' => (string) ($config->get('acknowledgement') ?? 'ICON recognises the First Peoples of this nation and their ongoing connection to culture and country. We acknowledge First Nations Peoples as the Traditional Owners, Custodians and Lore Keepers of the world’s oldest living culture and pay respects to their Elders past, present and emerging.'),
    'social' => [],
    'tags' => ['config:icon_site.footer', 'config:system.menu.footer-social'],
  ];
  $tree = \Drupal::menuTree();
  $params = (new \Drupal\Core\Menu\MenuTreeParameters())->setMaxDepth(1)->onlyEnabledLinks();
  $links = $tree->transform($tree->load('footer-social', $params), [['callable' => 'menu.default_tree_manipulators:checkAccess'], ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort']]);
  foreach ($links as $element) {
    if ($element->access && !$element->access->isAllowed()) {
      continue;
    }
    $out['social'][] = ['title' => (string) $element->link->getTitle(), 'url' => $element->link->getUrlObject()->toString()];
  }
  return $out;
}

/**
 * The global footer's offices: published Office content in list order
 * (Content → Offices), as the footer template reads them.
 *
 * @return array{offices: array<int, array{city: string, place: string, lines: string[], phone: string, phone_href: string, email: string, icon: int|null}>, tags: string[]}
 */
function icon_site_offices(): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $ids = $storage->getQuery()
    ->accessCheck(TRUE)
    ->condition('type', 'office')
    ->condition('status', 1)
    ->sort('field_office_weight', 'ASC')
    ->sort('title', 'ASC')
    ->execute();
  $out = ['offices' => [], 'tags' => ['node_list:office']];
  foreach ($storage->loadMultiple($ids) as $office) {
    $phone = trim((string) $office->get('field_office_phone')->value);
    $digits = preg_replace('/\D+/', '', $phone);
    $out['offices'][] = [
      'city' => (string) $office->label(),
      'place' => (string) $office->get('field_office_place')->value,
      'lines' => array_values(array_filter(array_map('trim', preg_split('/\r\n|\r|\n/', (string) $office->get('field_office_address')->value)))),
      'phone' => $phone,
      'phone_href' => $digits ? 'tel:' . (str_starts_with($digits, '0') ? '+61' . substr($digits, 1) : (str_starts_with($digits, '61') ? '+' . $digits : $digits)) : '',
      'email' => (string) $office->get('field_office_email')->value,
      'icon' => $office->get('field_office_icon')->target_id ? (int) $office->get('field_office_icon')->target_id : NULL,
    ];
    $out['tags'] = Cache::mergeTags($out['tags'], $office->getCacheTags());
  }
  return $out;
}

/**
 * Implements hook_preprocess_HOOK() for media.html.twig.
 *
 * An Icon in the media library's grid shows the SVG itself (its thumbnail
 * would be the generic file icon): inlined in the text colour on white.
 */
function icon_site_preprocess_media(array &$variables): void {
  $media = $variables['media'] ?? NULL;
  if (!$media instanceof MediaInterface || $media->bundle() !== 'icon' || ($variables['view_mode'] ?? '') !== 'media_library') {
    return;
  }
  $svg = (new \Drupal\icon_site\Twig\IconSiteExtension(\Drupal::entityTypeManager()))->inlineSvg((string) $media->id(), '');
  $variables['content']['icon_svg'] = [
    '#markup' => \Drupal\Core\Render\Markup::create('<div style="aspect-ratio:1;display:grid;place-items:center;padding:14%;box-sizing:border-box;color:#222;background:#fff">' . $svg . '</div>'),
    '#weight' => -10,
  ];
}

/**
 * The Work form's legacy folio card: the Layers field sits closed in its own
 * details, out of the way of the new tile, for the projects brought over
 * from the old site. Called from icon_site_form_node_form_alter().
 */
function _icon_site_work_legacy_group(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if ($node->bundle() !== 'work' || !isset($form['field_work_legacy_layers'])) {
    return;
  }
  $form['legacy'] = [
    '#type' => 'details',
    '#title' => t('Legacy folio card (old site)'),
    '#description' => t('For a project brought over from iconagency.com.au: its tile there was a stack of square cut-out images that tilts to the cursor, each layer lifting a step further on hover. Add the layers here, back to front (one to six square PNGs), and the card uses that instead of the Tile above. Leave empty for the new tile.'),
    '#open' => !$node->get('field_work_legacy_layers')->isEmpty(),
    '#weight' => $form['field_work_tile']['#weight'] ?? 0,
  ];
  $form['field_work_legacy_layers']['#group'] = 'legacy';
}

/**
 * Implements hook_canvas_storable_prop_shape_alter().
 *
 * An icon prop — `type: integer` with `x-icon-media: true` — is stored as a
 * reference to an Icon media item and edited as a SELECT of the Fact icons
 * list (Content → Fact icons), so the dropdown is content-managed. The prop
 * evaluates to the media ID, which the component hands to icon_inline_svg()
 * to inline the file. Why an ID rather than the file URI: Canvas's widgets
 * display the prop's RESOLVED value — a select preselects the option whose
 * key equals it — so the resolved value must be what the widget shows. And
 * Canvas has no SVG media shape of its own: the Image shape only matches
 * Image-source media types, and Drupal's image field refuses SVG, hence the
 * File-source `icon` type and this mapping.
 */
function icon_site_canvas_storable_prop_shape_alter(CandidateStorablePropShape $storable_prop_shape): void {
  $schema = $storable_prop_shape->shape->schema;
  if (($schema['type'] ?? NULL) !== 'integer' || empty($schema['x-icon-media'])) {
    return;
  }
  $storable_prop_shape->fieldTypeProp = new FieldTypePropExpression('entity_reference', 'target_id');
  $storable_prop_shape->fieldStorageSettings = ['target_type' => 'media'];
  $storable_prop_shape->fieldInstanceSettings = [
    'handler' => 'default:media',
    'handler_settings' => [
      'target_bundles' => ['icon' => 'icon'],
      'sort' => ['field' => 'field_logo_weight.value', 'direction' => 'ASC'],
      'auto_create' => FALSE,
    ],
  ];
  $storable_prop_shape->fieldWidget = 'options_select';
}

/**
 * Implements hook_page_attachments().
 *
 * The Canvas editor is one React page; the side panel's forms are rendered
 * inside it, and a library attached by a block form's render array does not
 * reach it. So the panel lists' stylesheet rides on the editor page itself.
 */
function icon_site_page_attachments(array &$attachments): void {
  if (str_starts_with((string) \Drupal::routeMatch()->getRouteName(), 'canvas.')) {
    $attachments['#attached']['library'][] = 'icon_site/panel_lists';
  }
}

/**
 * A Hero slide form opened from the Canvas panel (?panel=1) lives in a
 * dialog over the editor: Save submits by ajax and closes the dialog (or
 * re-renders the form with its errors); Preview and Delete, which would
 * navigate away, are dropped.
 */
function _icon_site_panel_node_form_alter(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();
  if ($node->bundle() !== 'hero_slide' || !\Drupal::request()->query->get('panel')) {
    return;
  }
  $form['#prefix'] = '<div id="icon-panel-form">';
  $form['#suffix'] = '</div>';
  // remember whether this save CREATES the item (read after the save)
  array_unshift($form['actions']['submit']['#submit'], '_icon_site_panel_note_new');
  $form['actions']['submit']['#ajax'] = [
    'callback' => '_icon_site_panel_form_ajax',
    'wrapper' => 'icon-panel-form',
  ];
  $form['actions']['preview']['#access'] = FALSE;
  $form['actions']['delete']['#access'] = FALSE;
  // Other modules (menu_ui, path) add their sections AFTER this alter runs,
  // so the trimming happens at after-build, when the form is complete.
  $form['#after_build'][] = '_icon_site_panel_node_form_after_build';
}

/**
 * Trims the dialog'd slide form to its fields: no meta, menu, path, revision.
 */
function _icon_site_panel_node_form_after_build(array $form, FormStateInterface $form_state): array {
  // NOT `status`: a widget hidden with #access has no submitted value, and the
  // save unpublished the slide. Published stays — it is how a slide leaves
  // the reel without being deleted.
  // (`footer` is where the node form keeps that checkbox — leave it too.)
  // (`field_logo_weight`: the marquee panel's drag writes the order.)
  foreach (['menu', 'meta', 'revision_information', 'revision_log', 'uid', 'created', 'promote', 'sticky', 'path', 'advanced', 'field_logo_weight'] as $key) {
    if (isset($form[$key])) {
      $form[$key]['#access'] = FALSE;
    }
  }
  return $form;
}

/**
 * Save from the dialog: close it, or show the form again with its errors.
 */
function _icon_site_panel_note_new(array &$form, FormStateInterface $form_state): void {
  $form_state->set('icon_panel_was_new', $form_state->getFormObject()->getEntity()->isNew());
}

function _icon_site_panel_form_ajax(array $form, FormStateInterface $form_state): AjaxResponse {
  $response = new AjaxResponse();
  if ($form_state->hasAnyErrors()) {
    // The dialog has no message region: put the errors at the top of the
    // form itself, or a failed save looks like nothing happened.
    $form['panel_messages'] = ['#type' => 'status_messages', '#weight' => -100];
    $response->addCommand(new ReplaceCommand('#icon-panel-form', $form));
    return $response;
  }
  $response->addCommand(new CloseDialogCommand('#icon-panel-dialog'));
  // Tell the panel's sortable script what was saved — the entity's id and
  // whether it was created just now (a new Hero slide goes straight into
  // the reel) — so it can write the change and nudge Canvas to re-fetch
  // the block form.
  $entity = $form_state->getFormObject()->getEntity();
  $response->addCommand(new InvokeCommand('body', 'trigger', ['icon-panel:saved', [[(int) $entity->id(), (bool) $form_state->get('icon_panel_was_new')]]]));
  return $response;
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for media_form.
 *
 * A Logo / Icon media form opened from a Canvas panel (?panel=1) gets the
 * same dialog treatment as a Hero slide: ajax Save that closes the dialog,
 * no Preview / Delete, and the housekeeping sections trimmed.
 */
function icon_site_form_media_form_alter(array &$form, FormStateInterface $form_state): void {
  $media = $form_state->getFormObject()->getEntity();
  if (!in_array($media->bundle(), ['logo', 'icon'], TRUE) || !\Drupal::request()->query->get('panel')) {
    return;
  }
  $form['#prefix'] = '<div id="icon-panel-form">';
  $form['#suffix'] = '</div>';
  // remember whether this save CREATES the item (read after the save)
  array_unshift($form['actions']['submit']['#submit'], '_icon_site_panel_note_new');
  $form['actions']['submit']['#ajax'] = [
    'callback' => '_icon_site_panel_form_ajax',
    'wrapper' => 'icon-panel-form',
  ];
  $form['actions']['delete']['#access'] = FALSE;
  // Removing from the marquee lives HERE, behind Edit, not as a one-click
  // link in the list: it unpublishes (the file stays in the library).
  if (isset($form['status']['widget']['value'])) {
    $form['status']['widget']['value']['#title'] = t('Shown on the site');
    $form['status']['widget']['value']['#description'] = t('Untick to take it out of the marquee without deleting it.');
  }
  $form['actions']['remove'] = [
    '#type' => 'submit',
    '#value' => t('Remove from marquee'),
    '#weight' => 10,
    '#attributes' => ['class' => ['button', 'button--danger', 'icon-panel__remove']],
    '#submit' => ['_icon_site_panel_remove_submit', '::submitForm', '::save'],
    '#ajax' => [
      'callback' => '_icon_site_panel_form_ajax',
      'wrapper' => 'icon-panel-form',
    ],
  ];
  $form['#after_build'][] = '_icon_site_panel_node_form_after_build';
}

/**
 * "Remove from marquee": unpublish, then the normal save.
 */
function _icon_site_panel_remove_submit(array &$form, FormStateInterface $form_state): void {
  $form_state->setValue(['status', 'value'], 0);
}
