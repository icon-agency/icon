includes:
  - vendor/mglaman/phpstan-drupal/extension.neon
  - vendor/mglaman/phpstan-drupal/rules.neon
  - vendor/phpstan/phpstan-deprecation-rules/rules.neon
parameters:
  level: 1
  paths:
    - web/modules/custom
    - web/themes/custom
  excludePaths:
    analyse:
      - web/themes/custom/icon/js
  scanDirectories:
    - web/core
  tmpDir: .tmp/phpstan
